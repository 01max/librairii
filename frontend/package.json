{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:accessibility": "node ./scripts/frontend-accessibility.mjs",
    "test:performance": "node ./scripts/frontend-performance.mjs",
    "test:release": "npm run test && npm run test:responsive && npm run test:visual && npm run test:accessibility",
    "test:responsive": "node ./scripts/frontend-responsive.mjs",
    "test:visual": "node ./scripts/frontend-visual-parity.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.0",
    "pngjs": "7.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.0.0",
    "vitest": "4.1.10"
  }
}
