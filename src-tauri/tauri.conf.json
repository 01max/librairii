{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Librairii",
  "version": "0.1.0",
  "identifier": "com.maxime.librairii",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../packaging/runtime/": "runtime/",
      "../packaging/stage/rails/": "rails/",
      "../packaging/bin/librairii-backend": "bin/librairii-backend"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
