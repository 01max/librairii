import { Button, ComboBox, VerticalBox, HorizontalBox, ScrollView, ListView, Palette } from "std-widgets.slint";
import { StoryBrowser, StoryGroup } from "browsing.slint";
import { MixedChoice, TagChip } from "states.slint";
export struct ProposalRow { title:string, warning:string, decision:int }
component ReviewChoice inherits ComboBox {
    in property <int> proposal-index;
    callback focus-row(int);
    changed has-focus => { if self.has-focus { root.focus-row(root.proposal-index); } }
}
component ReviewPane inherits FocusScope {
    in property <bool> french;
    in property <bool> interactive: true;
    in property <[string]> sources;
    in-out property <[ProposalRow]> proposals;
    in property <bool> pending;
    in property <int> decisions;
    callback decide(int,int);
    callback apply();
    accessible-role: groupbox;
    accessible-label: root.french ? "Révision en attente" : "Pending review";
    function scroll-end() { scroll.content-y = min(0px,scroll.visible-height - scroll.content-height); }
    key-pressed(event) => {
        if event.text == Key.PageDown { scroll.content-y = max(scroll.visible-height - scroll.content-height,scroll.content-y - scroll.visible-height / 2); return accept; }
        if event.text == Key.PageUp { scroll.content-y = min(0px,scroll.content-y + scroll.visible-height / 2); return accept; }
        return reject;
    }
    scroll := ScrollView { width: parent.width; height: parent.height; content-width: self.visible-width; content-height: layout.preferred-height;
        layout := VerticalBox { height: self.preferred-height; padding: 12px; spacing: 10px;
            Text { text: root.french ? "Sources — Collections" : "Sources — Collections"; color: Palette.foreground; font-weight: 600; wrap: word-wrap; }
            for source in root.sources: TagChip { label: source; }
            Rectangle { height: 1px; background: Palette.border; }
            Text { text: root.french ? "Révision en attente" : "Pending review"; color: Palette.foreground; font-weight: 600; }
            Text { text: root.french ? "Rien n’est approuvé automatiquement." : "Nothing is approved automatically."; color: Palette.foreground; wrap: word-wrap; }
            for proposal[index] in root.proposals: VerticalBox {
                padding: 0px; spacing: 4px;
                Text { text: proposal.title; color: Palette.foreground; wrap: word-wrap; }
                Text { text: proposal.warning; color: Palette.foreground; wrap: word-wrap; }
                ReviewChoice { enabled: root.interactive && !root.pending; proposal-index: index; focus-row(row) => { scroll.content-y = max(scroll.visible-height - scroll.content-height,min(0px,-row * 94px - 100px)); } accessible-label: proposal.title; model: root.french ? ["Pas maintenant", "Ajouter", "Exclure", "Conserver"] : ["Not now", "Add", "Exclude", "Keep"]; current-index: proposal.decision; selected(_) => { root.decide(index,self.current-index); } }
            }
            MixedChoice { enabled: root.interactive; french: root.french; label: root.french ? "Étiquette de la sélection" : "Selection tag"; changed has-focus => { if self.has-focus { root.scroll-end(); } } }
            Button { enabled: root.interactive && root.decisions > 0 && !root.pending; text: root.french ? "Appliquer les décisions" : "Apply decisions"; changed has-focus => { if self.has-focus { root.scroll-end(); } } clicked => { root.apply(); } }
        }
    }
}
// Approved membership and pending decisions use separate native panels. The
// section-15 controller supplies/revalidates domain authority at commitment.
export component Workspace inherits Rectangle {
    min-width: 0px; min-height: 0px;
    in property <bool> french;
    in property <bool> interactive: true;
    in property <bool> wide;
    in property <[StoryGroup]> members;
    in property <int> count;
    in property <[string]> sources;
    in-out property <[ProposalRow]> proposals;
    in property <bool> pending;
    in property <int> decisions;
    in-out property <int> selected-index;
    callback select(int);
    callback decide(int,int);
    callback apply();
    approved := Rectangle {
        x: 0px; y: 0px; width: root.wide ? parent.width * 0.54 : parent.width; height: root.wide ? parent.height : parent.height * 0.46;
        VerticalBox { padding: 0px;
            Text { text: root.french ? "Histoires approuvées" : "Approved stories"; color: Palette.foreground; font-weight: 600; }
            StoryBrowser { enabled: root.interactive; groups: root.members; count: root.count; columns: 1; mode: 0; label: root.french ? "Membres approuvés" : "Approved members"; selected-index <=> root.selected-index; select(index) => { root.select(index); } }
        }
    }
    Rectangle {
        x: root.wide ? approved.width + 12px : 0px; y: root.wide ? 0px : approved.height + 8px;
        width: parent.width - self.x; height: parent.height - self.y;
        background: Palette.alternate-background;
        ReviewPane { interactive: root.interactive; x: 0px; y: 0px; width: parent.width; height: parent.height; french: root.french; sources: root.sources; proposals <=> root.proposals; pending: root.pending; decisions: root.decisions; decide(index,value) => { root.decide(index,value); } apply => { root.apply(); } }
    }
}
