import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { EditAction } from "states.slint";
export struct FilterRow { index:int, label:string, boolean:bool, state:int }
export struct ActiveFilterRow { index:int, label:string }
export component Filters inherits FocusScope {
    in property <bool> french;
    in property <[FilterRow]> options;
    in property <[ActiveFilterRow]> active;
    in-out property <string> search;
    in-out property <int> sort-index;
    out property <int> displayed-sort-index: sort-choice.current-index;
    out property <bool> clear-focused: clear-button.has-focus;
    out property <length> clear-window-y: clear-button.absolute-position.y;
    out property <length> clear-height: clear-button.height;
    out property <bool> first-focused: filter-search.has-focus;
    callback search-edited(string);
    callback option-edited(int,int);
    callback remove(int);
    callback clear-all();
    callback clear-tags();
    callback sort-selected(int);
    callback reveal(length,length);
    function reveal-option(y:length, height:length, active:bool) {
        if active {
            let top=active-list.absolute-position.y;
            let next=max(min(0px,active-list.visible-height - active-list.content-height),min(0px,active-list.content-y + (y<top ? top - y : y+height>top+active-list.visible-height ? top+active-list.visible-height - y - height : 0px)));
            active-list.content-y=next;
            root.reveal(max(top,min(y,top+active-list.visible-height - height)),height);
        } else {
            let top=options-list.absolute-position.y;
            let next=max(min(0px,options-list.visible-height - options-list.content-height),min(0px,options-list.content-y + (y<top ? top - y : y+height>top+options-list.visible-height ? top+options-list.visible-height - y - height : 0px)));
            options-list.content-y=next;
            root.reveal(max(top,min(y,top+options-list.visible-height - height)),height);
        }
    }
    public function activate() { filter-search.focus(); }
    public function edit(action: EditAction) {
        if !filter-search.has-focus { return; }
        if action == EditAction.undo { filter-search.undo(); }
        else if action == EditAction.redo { filter-search.redo(); }
        else if action == EditAction.cut { filter-search.cut(); }
        else if action == EditAction.copy { filter-search.copy(); }
        else if action == EditAction.paste { filter-search.paste(); }
        else { filter-search.select-all(); }
    }
    VerticalBox { width: parent.width; height: parent.height; padding: 0px; spacing: 8px;
        filter-search := LineEdit { text <=> root.search; accessible-label: root.french ? "Rechercher un filtre" : "Search filters"; placeholder-text: self.accessible-label; edited => { root.search-edited(self.text); } changed has-focus => { if self.has-focus { root.reveal(self.absolute-position.y,self.height); } } }
        sort-choice := ComboBox { accessible-label: root.french ? "Trier les histoires" : "Sort stories"; model: root.french ? ["Ajout récent", "Nom de A à Z"] : ["Recently added", "Name A–Z"]; current-index <=> root.sort-index; selected(_) => { root.sort-selected(self.current-index); } changed has-focus => { if self.has-focus { root.reveal(self.absolute-position.y,self.height); } } }
        Text { visible: root.active.length > 0; height: root.active.length > 0 ? 22px : 0px; text: root.french ? "Filtres actifs" : "Active filters"; color: Palette.foreground; }
        active-list := ListView { height: root.active.length > 0 ? 72px : 0px;
            for entry in root.active: Button { text: (root.french ? "Retirer · " : "Remove · ") + entry.label; clicked => { root.activate(); root.remove(entry.index); } changed has-focus => { if self.has-focus { root.reveal-option(self.absolute-position.y,self.height,true); } } }
        }
        options-list := ListView { vertical-stretch: 1; min-height: 120px;
            for entry in root.options: HorizontalBox { height: 38px; padding: 0px;
                property <int> state: entry.state;
                if entry.boolean: ComboBox { horizontal-stretch: 1; accessible-label: entry.label; model: root.french ? [entry.label + " · Tous", entry.label + " · Attribué", entry.label + " · Non attribué"] : [entry.label + " · Any", entry.label + " · Tagged", entry.label + " · Not tagged"]; current-index <=> parent.state; selected(_) => { root.option-edited(entry.index,self.current-index); } changed has-focus => { if self.has-focus { root.reveal-option(self.absolute-position.y,self.height,false); } } }
                if !entry.boolean: CheckBox { horizontal-stretch: 1; text: entry.label; checked: entry.state == 1; toggled => { root.option-edited(entry.index,self.checked ? 1 : 0); } changed has-focus => { if self.has-focus { root.reveal-option(self.absolute-position.y,self.height,false); } } }
            }
        }
        Text { visible: root.options.length == 0; height: root.options.length == 0 ? 24px : 0px; text: root.french ? "Aucun filtre correspondant." : "No matching filters."; color: Palette.foreground; }
        HorizontalBox { padding: 0px;
            Button { text: root.french ? "Effacer les filtres d’étiquettes" : "Clear tag filters"; clicked => { root.activate(); root.clear-tags(); } changed has-focus => { if self.has-focus { root.reveal(self.absolute-position.y,self.height); } } }
            clear-button := Button { text: root.french ? "Tout effacer" : "Clear all"; enabled: root.active.length > 0; clicked => { root.clear-all(); } changed has-focus => { if self.has-focus { root.reveal(self.absolute-position.y,self.height); } } }
        }
    }
}
