import { TagChip } from "states.slint";
import { FlagControl } from "flags.slint";
import { Button, CheckBox, ListView, Palette, ScrollView, VerticalBox } from "std-widgets.slint";
export struct TagRow { label:string, color:color }
export struct StoryRow { member-status:string, acceptance:string, matches:string, broken:bool, bulk:bool, uuid:string, technical:string, facts:string, display-sources:string, tags:[TagRow], metadata:string, index: int, title: string, author: string, description: string, warning: string, provenance: string, cover: image }
export struct StoryGroup { cards: [StoryRow] }
export component StoryBrowser inherits FocusScope {
    in property <bool> french;
    in property <[StoryGroup]> groups;
    in property <int> count;
    in property <int> mode;
    in property <int> columns: 1;
    in property <bool> membership;
    in property <string> label;
    in-out property <int> selected-index: -1;
    private property <int> focused-index: 0;
    private property <length> row-height: root.membership ? min(96px,max(86px,root.height)) : root.mode == 0 ? min(82px,max(76px,root.height)) : min(root.mode == 1 ? 230px : 310px,max(148px,root.height));
    out property <length> mounted-row-height: root.row-height;
    callback select(int);
    callback toggle(int);
    callback reveal(length,length);
    public function focus-bulk(index:int) { root.focus();root.move(index,false); }
    callback focus-entered();
    accessible-role: list;
    accessible-label: root.label;
    accessible-item-count: root.count;
    accessible-delegate-focus: root.focused-index - floor(-view.content-y / root.row-height) * root.columns;
    function move(index: int, select: bool) {
        root.focused-index = max(0, min(root.count - 1, index));
        let row = floor(root.focused-index / root.columns);
        if row * root.row-height + view.content-y < 0px { view.content-y = -row * root.row-height; }
        else if (row + 1) * root.row-height + view.content-y > view.visible-height { view.content-y = view.visible-height - (row + 1) * root.row-height; }
        root.reveal(root.absolute-position.y + row * root.row-height + view.content-y,root.row-height);
        if select && root.count > 0 { root.selected-index = root.focused-index; root.select(root.selected-index); }
    }
    focus-changed-event => { if self.has-focus { root.focus-entered(); root.move(max(0,root.selected-index),false); } }
    key-pressed(event) => {
        if event.text == Key.End { root.move(root.count - 1,!event.modifiers.control); }
        else if event.text == Key.Home { root.move(0,!event.modifiers.control); }
        else if event.text == Key.DownArrow { root.move(root.focused-index + root.columns,!event.modifiers.control); }
        else if event.text == Key.UpArrow { root.move(root.focused-index - root.columns,!event.modifiers.control); }
        else if event.text == Key.RightArrow { root.move(root.focused-index + 1,!event.modifiers.control); }
        else if event.text == Key.LeftArrow { root.move(root.focused-index - 1,!event.modifiers.control); }
        else if event.text == Key.PageDown { root.move(root.focused-index + max(1,floor(view.visible-height / root.row-height)) * root.columns,!event.modifiers.control); }
        else if event.text == Key.PageUp { root.move(root.focused-index - max(1,floor(view.visible-height / root.row-height)) * root.columns,!event.modifiers.control); }
        else if event.text == Key.Space { root.toggle(root.focused-index); }
        else if event.text == Key.Return { root.move(root.focused-index,true); }
        else { return reject; }
        return accept;
    }
    view := ListView {
        width: parent.width; height: parent.height;
        accessible-role: none;
        for group[row] in root.groups: Rectangle {
            height: root.row-height;
            accessible-role: none;
            for card[column] in group.cards: Rectangle {
                x: column * parent.width / root.columns;
                width: parent.width / root.columns - 8px;
                height: parent.height - 8px;
                border-radius: 6px;
                background: card.index == root.selected-index ? Palette.selection-background : Palette.background;
                border-width: root.has-focus && card.index == root.focused-index ? 2px : 1px;
                border-color: root.has-focus && card.index == root.focused-index ? Palette.foreground : Palette.border;
                accessible-role: list-item;
                accessible-label: card.title + (card.warning == "" ? "" : ", " + card.warning) + (card.provenance == "" ? "" : ", " + card.provenance) + (root.membership ? ", " + card.member-status + ", " + card.acceptance + ", " + card.matches : "");
                accessible-item-index: card.index;
                accessible-item-selectable: true;
                accessible-item-selected: card.index == root.selected-index;
                accessible-enabled: root.enabled;
                accessible-action-default => { root.move(card.index,true); root.focus(); }
                Image { x: 8px; y: 8px; width: root.mode == 0 ? 64px : parent.width - 16px; height: root.mode == 0 ? parent.height - 16px : parent.height - 82px;
                    opacity: card.broken ? 0.45 : 1;
                    source: card.cover.width > 0 ? card.cover : @image-url("../assets/library.svg"); image-fit: contain;
                }
                Text { x: root.mode == 0 ? 84px : 8px; y: root.mode == 0 ? (root.membership ? 3px : 7px) : parent.height - 72px;
                    width: parent.width - self.x - 36px; height: root.membership ? 20px : 38px;
                    text: card.title; wrap: word-wrap; overflow: elide; font-weight: 600;
                    color: card.index == root.selected-index ? Palette.selection-foreground : Palette.foreground;
                }
                Text { visible: !root.membership; x: root.mode == 0 ? 84px : 8px; y: parent.height - 28px; width: parent.width - self.x - 8px; height: 22px;
                    text: (card.warning != "" ? card.warning : card.author) + (card.provenance != "" ? " · " + card.provenance : ""); overflow: elide;
                    color: card.index == root.selected-index ? Palette.selection-foreground : Palette.foreground;
                }
                if root.membership: Text { x: 84px; y: 24px; width: parent.width - 92px; height: 18px; text: card.member-status; overflow: elide; color: card.index == root.selected-index ? Palette.selection-foreground : Palette.foreground; }
                if root.membership: Text { x: 84px; y: 42px; width: parent.width - 92px; height: 18px; text: card.acceptance; overflow: elide; color: card.index == root.selected-index ? Palette.selection-foreground : Palette.foreground; }
                if root.membership: Text { x: 84px; y: 60px; width: parent.width - 92px; height: 18px; text: card.matches; overflow: elide; color: card.index == root.selected-index ? Palette.selection-foreground : Palette.foreground; }
                TouchArea { enabled: root.enabled; clicked => { root.move(card.index,true); root.focus(); } }
                CheckBox { x: parent.width - 30px; y: 4px; width: 26px; text: ""; accessible-label: (card.bulk ? (root.french ? "Désélectionner · " : "Deselect · ") : (root.french ? "Sélectionner · " : "Select · ")) + card.title; checked: card.bulk; enabled: root.enabled; toggled => { root.toggle(card.index); } }
            }
        }
    }
}
export component Inspector inherits Rectangle {
    in property <bool> interactive: true;
    callback request-data();
    callback focused();
    in property <bool> french;
    in property <StoryRow> story;
    in property <bool> flag-enabled;
    in property <bool> flag-multiple;
    in property <bool> flag-mixed;
    in property <bool> flag-checked;
    in property <bool> flag-pending;
    in property <bool> flag-can-undo;
    in property <string> flag-summary;
    in property <string> flag-notice;
    in property <string> flag-target-label;
    callback flag-change(bool);
    callback undo-flags();
    private property <int> focused-control;
    public function focus-current() { if root.focused-control == 0 || (!root.flag-enabled && !root.flag-can-undo) || root.flag-pending { technical.focus(); } else { flags.focus-control(root.focused-control); } }
    public function sync-flags() {flags.sync-checked();}
    public function focus-flag() { flags.focus-control(1); }
    out property <bool> flag-focused: flags.toggle-focused;
    out property <bool> first-focused: root.flag-enabled && !root.flag-pending ? flags.toggle-focused : root.flag-can-undo && !root.flag-pending ? flags.undo-focused : technical.has-focus;
    public function focus-first() { if root.flag-enabled && !root.flag-pending { flags.focus-control(1); } else if root.flag-can-undo && !root.flag-pending { flags.focus-control(2); } else { technical.focus(); } }
    background: Palette.alternate-background;
    private property <bool> technical-open;
    out property <length> scroll-position: details.content-y;
    public function reset() { details.content-y = 0px; root.technical-open = false; }
    private property <string> identity: root.story.uuid;
    changed identity => { root.reset(); }
    out property <bool> technical-focused: technical.has-focus;
    public function focus-technical() { technical.focus(); }
    public function scroll(key: string) {
        if key == Key.Home { details.content-y = 0px; }
        else if key == Key.End { details.content-y = min(0px, details.visible-height - details.content-height); }
        else { details.content-y = max(min(0px, details.visible-height - details.content-height), min(0px, details.content-y + (key == Key.PageUp ? 1 : -1) * details.visible-height)); }
    }
    details := ScrollView { width: parent.width; height: parent.height; content-width: self.visible-width; content-height: inspector-layout.preferred-height;
        inspector-layout := VerticalBox { height: self.preferred-height; padding: 14px; spacing: 12px;
            Text { vertical-stretch: 0; text: root.french ? "Détails de l’histoire" : "Story details"; color: Palette.foreground; font-weight: 600; }
            Text { vertical-stretch: 0; text: root.story.title != "" ? root.story.title : (root.french ? "Sélectionnez une histoire pour afficher ses détails." : "Select a story to see its details."); wrap: word-wrap; color: Palette.foreground; font-size: 18px; }
            Image { source: root.story.cover; opacity: root.story.broken ? 0.45 : 1; image-fit: contain; height: root.story.cover.width > 0 ? min(160px,max(48px,root.height / 3)) : 0px; }
            Text { vertical-stretch: 0; text: root.story.warning; wrap: word-wrap; color: Palette.foreground; font-weight: 600; }
            flags := FlagControl { french: root.french; active: root.interactive; available: root.flag-enabled; multiple:root.flag-multiple; mixed:root.flag-mixed; checked: root.flag-checked; pending: root.flag-pending; can-undo: root.flag-can-undo; title: root.flag-target-label != "" ? root.flag-target-label : root.story.title; summary: root.flag-summary; notice: root.flag-notice;
                change(value) => { root.flag-change(value); } undo => { root.undo-flags(); }
                focused(kind) => { root.focused-control=kind;root.focused();
                    let delta=self.absolute-position.y<details.absolute-position.y ? details.absolute-position.y - self.absolute-position.y : self.absolute-position.y+self.height>details.absolute-position.y+details.visible-height ? details.absolute-position.y+details.visible-height - self.absolute-position.y - self.height : 0px;
                    details.content-y=max(min(0px,details.visible-height - details.content-height),min(0px,details.content-y+delta));
                }
            }
            Text { vertical-stretch: 0; text: root.story.metadata; wrap: word-wrap; color: Palette.foreground; }
            Text { vertical-stretch: 0; text: root.french ? "Étiquettes" : "Tags"; color: Palette.foreground; font-weight: 600; }
            if root.story.tags.length == 0: Text { vertical-stretch: 0; text: root.french ? "Aucune étiquette." : "No tags yet."; color: Palette.foreground; }
            for tag in root.story.tags: TagChip { label: tag.label; tag-color: tag.color; }
            Text { vertical-stretch: 0; text: root.story.author; wrap: word-wrap; color: Palette.foreground; }
            Text { vertical-stretch: 0; text: root.story.description != "" ? root.story.description : (root.french ? "Aucune description n’est encore disponible." : "No story description is available yet."); wrap: word-wrap; color: Palette.foreground; }
            Text { vertical-stretch: 0; text: root.story.provenance; wrap: word-wrap; color: Palette.foreground; }
            if root.story.member-status != "": Text { vertical-stretch: 0; text: root.story.member-status + "\n" + root.story.acceptance + "\n" + root.story.matches; wrap: word-wrap; color: Palette.foreground; }
            Text { vertical-stretch: 0; text: root.story.facts; wrap: word-wrap; color: Palette.foreground; }
            Text { vertical-stretch: 0; text: root.story.display-sources; wrap: word-wrap; color: Palette.foreground; }
            technical := Button { enabled: root.interactive && root.story.uuid != ""; text: root.technical-open ? (root.french ? "Masquer les détails techniques" : "Hide technical details") : (root.french ? "Afficher les détails techniques" : "Show technical details"); clicked => { root.technical-open = !root.technical-open; if root.technical-open { root.request-data(); } } changed has-focus => { if self.has-focus { root.focused-control=0;root.focused(); details.content-y = min(0px, details.visible-height - details.content-height); } } }
            if root.technical-open: Text { vertical-stretch: 0; text: root.story.technical; wrap: word-wrap; color: Palette.foreground; }
        }
    }
}
