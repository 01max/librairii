                    dialog-content := VerticalBox { height: self.preferred-height; padding: 0px; spacing: 0px;
                        if root.dialog == 1: AboutSlint { }
                        dialog-inspector := Inspector { visible: root.dialog == 3; height: root.dialog == 3 ? max(80px, dialog-scroll.visible-height) : 0px; french: root.french; story: root.selected-story; request-data => { root.request-details(); }
                            flag-enabled: root.detail-flag-enabled; flag-checked: root.detail-flag-checked; flag-pending: root.flag-pending; flag-can-undo: root.flag-undo-enabled; flag-notice: root.flag-notice; flag-change(value) => { root.detail-flag-change(value); } undo-flags => { root.undo-flags(); }
                        }
                        if root.dialog == 9: Caption { text: (root.french ? "Retirer cette histoire de la bibliothèque ?\n« " : "Remove this story from the library?\n“") + root.removal-title + (root.french ? " » sera déplacée dans la corbeille de l’application. Votre fichier d’origine restera à son emplacement." : "” will move to application trash. Your original source file will stay where it is."); }
                        if root.dialog == 9: Caption { text: root.removal-error; }
                        if root.dialog == 4: Caption { text: root.french ? "Choisissez où conserver votre bibliothèque. Votre bibliothèque n’est créée qu’après la confirmation de son emplacement. Vous pouvez d’abord choisir la langue dans les réglages." : "Choose where to keep your library. Your library is created only after you confirm its location. You can choose your language in Settings first."; }
                        if root.dialog == 5: Caption { text: root.french ? "La bibliothèque attendue est indisponible ou nécessite une récupération. Ses fichiers sont conservés. Reconnectez son volume puis réessayez ; ne remplacez pas votre bibliothèque." : "The expected library is unavailable or needs recovery. Its files are preserved. Reconnect its volume and retry; keep your existing library."; }
                        if root.dialog == 6: Caption { text: root.status != "" ? root.status : (root.french ? "Vos histoires et leurs archives restent dans votre bibliothèque locale." : "Your stories and archives stay in your local library."); }
                        filters := Filters { visible: root.dialog == 8; height: root.dialog == 8 ? max(480px,dialog-scroll.visible-height) : 0px; french: root.french; options: root.filter-rows; sort-manual-available: root.sort-manual-available; active: root.active-filter-rows; sort-index <=> root.sort-index; search <=> root.filter-search-query;
                            search-edited(text) => { root.filter-search(text); }
                            option-edited(index,value) => { root.filter-edit(index,value); }
                            collapse(index) => { root.filter-collapse(index); }
                            remove(index) => { root.filter-remove(index); }
                            clear-all => { root.filter-clear(); }
                            clear-tags => { root.filter-clear-tags(); }
                            sort-selected(index) => { root.sort-selected(index); }
                            reveal(y,height) => { root.reveal-dialog(y,height); }
                        }
                        tag-manager := TagManager { visible: root.dialog == 10; height: self.visible ? self.preferred-height : 0px; french: root.french; active: root.startup-phase == 3 && root.dialog == 10 && !root.tag-busy; editable: root.tag-editable; choice: root.tag-choice; creating: root.tag-creating; definitions: root.tag-definitions; values: root.tag-values; source: root.tag-source; notice: root.tag-notice;
                            move-up: root.tag-move-up; move-down: root.tag-move-down; value-move-up: root.tag-value-move-up; value-move-down: root.tag-value-move-down;
                            definition-index <=> root.tag-definition-index; value-index <=> root.tag-value-index; key <=> root.tag-key; label <=> root.tag-label; color <=> root.tag-color; kind <=> root.tag-kind; value-key <=> root.tag-value-key; value-label <=> root.tag-value-label;
                            select-definition(index) => { root.select-tag-definition(index); } select-value(index) => { root.select-tag-value(index); }
                            save-definition => { root.save-tag-definition(); } save-value => { root.save-tag-value(); }
                            move-definition(offset) => { root.move-tag-definition(offset); } move-value(offset) => { root.move-tag-value(offset); }
                            delete-definition => { root.delete-tag-definition(); } delete-value => { root.delete-tag-value(); } reveal(y,h) => { root.reveal-dialog(y,h); }
                        }
                        assignments := Assignments { visible: root.dialog == 11; height: self.visible ? max(400px,dialog-scroll.visible-height) : 0px; french: root.french; active: root.startup-phase == 3 && root.dialog == 11 && !root.tag-busy; summary: root.assignment-summary; notice: root.tag-notice; rows: root.assignment-rows;
                            refresh => { root.refresh-assignments(); } assign(index,value) => { root.assignment-edit(index,value); } reveal(y,h) => { root.reveal-dialog(y,h); }
                        }
                        if root.dialog == 12: Caption { text: root.tag-impact; }
                        if root.dialog == 12: Caption { text: root.tag-notice; accessible-live-region: polite; }
                        collection-manager := CollectionManager { visible: root.dialog == 13; height: self.visible ? self.preferred-height : 0px; french: root.french; active: root.dialog == 13 && root.startup-phase == 3 && !root.collection-busy;
                            creating: root.collection-creating; openable: root.collection-openable; move-up: root.collection-move-up; move-down: root.collection-move-down; definitions: root.collection-definitions; choices: root.collection-choices; selected <=> root.collection-index; name <=> root.collection-name; notice: root.collection-notice; status: root.collection-status; criteria: root.collection-criteria; union-summary: root.collection-union-summary; union-available: root.collection-union-available; union-active: root.collection-union-active; union-selected: root.collection-union-selected;
                            select(index) => {root.select-collection(index);}save=>{root.save-collection();}duplicate=>{root.duplicate-collection();}move(offset)=>{root.move-collection(offset);}open=>{root.open-collection();}replace=>{root.replace-collection();}delete=>{root.delete-collection();}edit-query=>{root.edit-current-collection-query();}edit-saved-query=>{root.edit-saved-collection-query();}toggle(index)=>{root.toggle-collection-union(index);}toggle-selected=>{root.toggle-selected-collection-union();}open-union=>{root.open-collection-union();}save-union=>{root.save-collection-union();}reveal(y,h)=>{root.reveal-dialog(y,h);}
                        }
                        if root.dialog == 14: Caption { text: root.collection-impact; }
                        if root.dialog == 14: Caption { text: root.collection-notice; accessible-live-region: polite; }
                        if root.dialog == 7: Caption { text: root.commit-pending ? (root.french ? "Enregistrement en cours. Attendez la fin de cette étape avant de fermer." : "Saving changes. Wait for this step to finish before closing.") : (root.french ? "Vous pouvez continuer ou demander l’arrêt. Les effets déjà enregistrés sont conservés." : "Keep working or request a safe stop. Already committed changes are preserved."); }
                    }
                }
                attribution-button := Button { visible: root.dialog == 1; height: root.dialog == 1 ? 40px : 0px; enabled: !root.closing && root.dialog == 1; text: root.french ? "Site web de Slint" : "Slint website"; clicked => { Platform.open-url("https://slint.dev"); } }
                HorizontalBox { visible: root.dialog == 2; height: root.dialog == 2 ? 40px : 0px;
                    english-button := Button { text: "English"; enabled: !root.closing && root.dialog == 2; clicked => { root.change-language("en"); } }
                    Button { text: "Français"; enabled: !root.closing && root.dialog == 2; clicked => { root.change-language("fr"); } }
                }
                stop-close-button := Button { visible: root.dialog == 7; height: root.dialog == 7 ? 40px : 0px; enabled: !root.closing && !root.commit-pending; text: root.french ? "Arrêter et fermer" : "Stop and close"; clicked => { root.quit(); } }
                edit-tags-button := Button { visible: root.dialog == 3; height: self.visible ? 40px : 0px; enabled: !root.detail-pending && root.edit-tags-enabled; text: root.edit-tags-label != "" ? root.edit-tags-label : (root.french ? "Modifier les étiquettes" : "Edit tags"); clicked => { root.edit-tags(); } }
                HorizontalBox { visible: root.dialog == 12; height: self.visible ? 40px : 0px; padding: 0px;
                    cancel-tag := Button { enabled: !root.tag-busy; text: root.french ? "Annuler" : "Cancel"; clicked => {root.close-dialog();} }
                    confirm-tag := Button { enabled: !root.tag-busy; text: root.french ? "Supprimer définitivement" : "Delete permanently"; clicked => {root.confirm-tag-delete();} }
                }
                HorizontalBox { visible: root.dialog == 14 && !root.collection-replacing; height: self.visible ? 32px : 0px; padding: 0px;
                    collection-prev := Button { enabled: !root.collection-busy && root.collection-impact-previous; text: root.french ? "Étagère précédente" : "Previous Shelf"; clicked => {root.collection-impact-page(-1);} }
                    collection-next := Button { enabled: !root.collection-busy && root.collection-impact-next; text: root.french ? "Étagère suivante" : "Next Shelf"; clicked => {root.collection-impact-page(1);} }
                }
                HorizontalBox { visible: root.dialog == 14; height: self.visible ? 40px : 0px; padding: 0px;
                    cancel-collection := Button { enabled: !root.collection-busy; text: root.french ? "Annuler" : "Cancel"; clicked => {root.close-dialog();} }
                    confirm-collection := Button { enabled: !root.collection-busy; text: root.collection-replacing ? (root.french ? "Remplacer la requête" : "Replace saved query") : (root.french ? "Supprimer et conserver les histoires" : "Delete and keep approved stories"); clicked => {root.confirm-collection-change();} }
                }
                remove-story-button := Button { visible: root.dialog == 3; height: root.dialog == 3 ? 40px : 0px; enabled: !root.detail-pending && root.selected-story.uuid != ""; text: root.french ? "Retirer de la bibliothèque…" : "Remove from library…"; clicked => { root.begin-removal(); } }
                HorizontalBox { height: root.dialog == 9 ? 40px : 0px; visible: root.dialog == 9;
                    keep-story := Button { enabled: !root.detail-pending; text: root.french ? "Conserver l’histoire" : "Keep story"; clicked => { root.close-dialog(); } }
                    trash-story := Button { enabled: !root.detail-pending; text: root.detail-pending ? (root.french ? "Déplacement…" : "Moving to trash…") : (root.french ? "Déplacer dans la corbeille" : "Move to trash"); clicked => { root.remove-story(); } }
                }
                close-dialog-button := Button { visible: root.dialog != 9 && root.dialog != 12 && root.dialog != 14; height: self.visible ? 40px : 0px; enabled: !root.closing && !root.detail-pending && !root.tag-busy && !root.collection-busy; text: root.dialog == 7 ? (root.french ? "Continuer" : "Keep working") : (root.french ? "Fermer" : "Close"); clicked => { root.close-dialog(); } }
            }
        }
    }
}
