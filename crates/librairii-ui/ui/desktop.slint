                                    if root.collection-previews.length > 0: HorizontalBox { padding: 0px;
                                        Action { focus-key: 25; available: root.group-previous; text: root.french ? "Groupes précédents" : "Previous groups"; clicked => {root.change-group-page(-1);} changed has-focus => {if self.has-focus {root.reveal-library(self.absolute-position.y,self.height);}} }
                                        Action { focus-key: 26; available: root.group-next; text: root.french ? "Groupes suivants" : "Next groups"; clicked => {root.change-group-page(1);} changed has-focus => {if self.has-focus {root.reveal-library(self.absolute-position.y,self.height);}} }
                                    }
                                }
                            }
                        }
                        workspace-panel := Workspace { visible: root.workspace; max-width: root.workspace ? 100000px : 0px; interactive: root.workspace && !root.closing && !root.modal && !FocusState.sidebar; wide: root.wide; french: root.french; members: root.story-groups; count: root.story-count; sources: root.sources; proposals <=> root.proposals; pending: root.pending; decisions: root.decisions; selected-index <=> root.selected-index; select(index) => { root.select-story(index); } toggle(index) => { root.toggle-bulk(index); } decide(index,value) => { root.decide(index,value); } apply => { root.apply-decisions(); } }
                        side-inspector := Inspector { visible: root.wide && !root.workspace; width: self.visible ? 264px : 0px; interactive: !root.modal && !root.closing; french: root.french; story: root.selected-story; request-data => { root.request-details(); } focused => { FocusState.key = 32; }
                            flag-enabled: root.panel-flag-enabled; flag-checked: root.panel-flag-checked; flag-pending: root.flag-pending; flag-can-undo: root.flag-undo-enabled; flag-summary: root.panel-flag-summary; flag-target-label: root.panel-flag-target-label; flag-notice: root.flag-notice; flag-change(value) => { root.panel-flag-change(value); } undo-flags => { root.undo-flags(); }
                        }
                    }
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Action { visible: !root.compact; width: root.compact ? 0px : 76px; focus-key: 19; text: root.french ? "Retour" : "Back"; available: root.back-enabled; clicked => { root.history-step(-1); } }
                        Action { visible: !root.compact; width: root.compact ? 0px : 76px; focus-key: 20; text: root.french ? "Suivant" : "Forward"; available: root.forward-enabled; clicked => { root.history-step(1); } }
                        Action { focus-key: 16; text: root.french ? "Page précédente" : "Previous page"; available: root.previous-enabled; clicked => { root.change-page(-1); } }
                        Action { focus-key: 17; text: root.french ? "Page suivante" : "Next page"; available: root.next-enabled; clicked => { root.change-page(1); } }
                        Action { focus-key: 14; text: root.french ? "Détails…" : "Details…"; available: root.selected-index >= 0; clicked => { root.show-panel(8); } }
                    }
                }
            }
            if root.compact && root.sidebar-open: Rectangle { width: parent.width; height: parent.height; background: #0008;
                TouchArea { clicked => { root.close-sidebar(); } }
            }
            Rectangle {
                x: 0px; y: 0px;
                visible: !root.compact || root.sidebar-open;
                width: root.compact ? 280px : 216px; height: parent.height;
                sidebar-focus := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height;
                    key-pressed(event) => { if event.text == Key.Escape && root.compact { root.close-sidebar(); return accept; } return reject; }
                    navigation := Navigation { x: 0px; y: 0px; collections: root.collection-rows; shelves: root.shelf-rows; navigate(index) => { root.navigate-group(index); if root.compact { root.close-sidebar(); } } enabled: !root.modal; width: parent.width; height: parent.height; french: root.french; compact: root.compact; close => { root.close-sidebar(); } open-panel(kind) => { root.show-panel(kind); } }
                }
            }
        }
        if root.pending || root.startup-phase == 4: ProgressState { progress: root.progress; indeterminate: root.indeterminate || root.startup-phase == 4; label: root.status; }

    }

    if root.modal: Rectangle {
        width: parent.width; height: parent.height; background: #0008;
        TouchArea { clicked => { root.close-dialog(); } }
    }
    dialog-panel := Rectangle {
        visible: root.modal;
        x: max(16px,(parent.width - 600px)/2); y: 24px;
        width: min(600px,parent.width - 32px); height: parent.height - 48px;
        background: Palette.background; border-width: 2px; border-color: Palette.foreground; border-radius: 6px;
        accessible-role: groupbox;
        accessible-label: root.dialog == 13 ? (root.french ? "Gérer les Collections" : "Manage Collections") : root.dialog == 14 ? (root.french ? "Confirmer la modification de la Collection" : "Confirm Collection change") : root.dialog == 10 ? (root.french ? "Gérer les étiquettes" : "Manage tags") : root.dialog == 11 ? (root.french ? "Attribuer les étiquettes" : "Assign tags") : root.dialog == 12 ? (root.french ? "Confirmer l’impact" : "Confirm impact") : root.dialog == 9 ? (root.french ? "Confirmer le retrait" : "Confirm removal") : root.dialog == 1 ? (root.french ? "À propos de Slint" : "About Slint") : root.dialog == 2 ? (root.french ? "Réglages" : "Settings") : root.dialog == 3 ? (root.french ? "Détails" : "Details") : root.dialog == 4 ? (root.french ? "Configurer la bibliothèque" : "Set up your library") : root.dialog == 5 ? (root.french ? "Récupération de la bibliothèque" : "Library recovery") : root.dialog == 7 ? (root.french ? "Opération en cours" : "Operation in progress") : root.dialog == 8 ? (root.french ? "Filtres et tri" : "Filters and sort") : (root.french ? "Bibliothèque" : "Library");
        FocusScope {
            width: parent.width; height: parent.height;
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-dialog(); return accept; }
                if event.text == Key.PageDown || event.text == Key.PageUp || event.text == Key.Home || event.text == Key.End {
                    if root.dialog == 3 { dialog-inspector.scroll(event.text); }
                    else {
                        if event.text == Key.Home { dialog-scroll.content-y = 0px; }
                        else if event.text == Key.End { dialog-scroll.content-y = min(0px, dialog-scroll.visible-height - dialog-scroll.content-height); }
                        else { dialog-scroll.content-y = max(min(0px, dialog-scroll.visible-height - dialog-scroll.content-height), min(0px, dialog-scroll.content-y + (event.text == Key.PageUp ? 1 : -1) * dialog-scroll.visible-height)); }
                    }
                    return accept;
                }
                if event.text == Key.Tab {
                    if root.dialog == 13 { if event.modifiers.shift && collection-manager.first-focused {close-dialog-button.focus();return accept;} if !event.modifiers.shift && close-dialog-button.has-focus {collection-manager.activate();return accept;}return reject; }
                    if root.dialog == 14 {
                        if !event.modifiers.shift && confirm-collection.has-focus {if root.collection-impact-previous {collection-prev.focus();}else if root.collection-impact-next {collection-next.focus();}else {cancel-collection.focus();}return accept;}
                        if event.modifiers.shift && (collection-prev.has-focus || (collection-next.has-focus && !root.collection-impact-previous) || (cancel-collection.has-focus && !root.collection-impact-previous && !root.collection-impact-next)) {confirm-collection.focus();return accept;}
                        return reject;
                    }
                    if root.dialog == 12 { if cancel-tag.has-focus { confirm-tag.focus(); } else { cancel-tag.focus(); } return accept; }
                    if root.dialog == 10 { if event.modifiers.shift && tag-manager.first-focused { close-dialog-button.focus();return accept; } if !event.modifiers.shift && close-dialog-button.has-focus {tag-manager.activate();return accept;} return reject; }
                    if root.dialog == 11 { if event.modifiers.shift && assignments.first-focused { close-dialog-button.focus();return accept; } if !event.modifiers.shift && close-dialog-button.has-focus {assignments.activate();return accept;} return reject; }
                    if root.dialog == 9 { if keep-story.has-focus { trash-story.focus(); } else { keep-story.focus(); } return accept; }
                    if root.dialog == 3 {
                        if event.modifiers.shift && dialog-inspector.first-focused { close-dialog-button.focus(); return accept; }
                        if !event.modifiers.shift && close-dialog-button.has-focus { dialog-inspector.focus-first(); return accept; }
                        return reject;
                    }
                    if root.dialog == 8 {
                        if event.modifiers.shift && filters.first-focused { close-dialog-button.focus(); return accept; }
                        if !event.modifiers.shift && close-dialog-button.has-focus { filters.activate(); return accept; }
                        return reject;
                    }
                    if root.dialog == 1 {
                        if close-dialog-button.has-focus { attribution-button.focus(); } else { close-dialog-button.focus(); }
                        return accept;
                    }
                    if root.dialog == 7 && !root.commit-pending {
                        if close-dialog-button.has-focus { stop-close-button.focus(); } else { close-dialog-button.focus(); }
                        return accept;
                    }
                    if root.dialog != 2 { close-dialog-button.focus(); return accept; }
                    if event.modifiers.shift && english-button.has-focus { close-dialog-button.focus(); return accept; }
                    if !event.modifiers.shift && close-dialog-button.has-focus { english-button.focus(); return accept; }
                }
