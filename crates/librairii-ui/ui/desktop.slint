import { TagManager, Assignments, AssignmentRow } from "tags.slint";
import { FlagControl } from "flags.slint";
import { CollectionManager, CollectionChoice } from "collections.slint";
import { Workspace, ProposalRow } from "workspace.slint";
import { Filters, FilterRow, ActiveFilterRow } from "filters.slint";
import { ProgressState, EditAction } from "states.slint";
import { StoryRow, StoryGroup, StoryBrowser, Inspector } from "browsing.slint";
import { Button, CheckBox, LineEdit, VerticalBox, HorizontalBox, AboutSlint, Palette, ScrollView, ComboBox, ListView } from "std-widgets.slint";

global FocusState {
    in-out property <bool> modal: false;
    in-out property <bool> sidebar: false;
    in-out property <bool> ready: true;
    in-out property <bool> closing: false;
    in-out property <int> key: 11;
    in-out property <int> restore-epoch;
    in-out property <int> preview-focused-key;
}
component Action inherits Button {
    vertical-stretch: 0; horizontal-stretch: 0;
    height: 32px; min-width: 0px;
    in property <int> focus-key;
    in property <bool> available: true;
    enabled: root.available && !FocusState.closing && !FocusState.modal && (!FocusState.sidebar || root.focus-key >= 200);
    private property <int> epoch: FocusState.restore-epoch;
    changed has-focus => { if self.has-focus { FocusState.key = root.focus-key; } }
    changed epoch => { if !FocusState.modal && FocusState.key == root.focus-key { self.focus(); } }
}
component SearchField inherits LineEdit {
    enabled: FocusState.ready && !FocusState.closing && !FocusState.modal && !FocusState.sidebar;
    private property <int> epoch: FocusState.restore-epoch;
    changed has-focus => { if self.has-focus { FocusState.key = 30; } }
    changed epoch => { if !FocusState.modal && FocusState.key == 30 { self.focus(); } }
}
component PreviewBulk inherits CheckBox {
    in property <int> focus-key;
    callback reveal(length,length);
    enabled: FocusState.ready && !FocusState.closing && !FocusState.modal && !FocusState.sidebar;
    private property <int> epoch: FocusState.restore-epoch;
    changed has-focus => {if self.has-focus {FocusState.key=root.focus-key;root.reveal(self.absolute-position.y,self.height);}}
    changed epoch => {if !FocusState.modal && !FocusState.sidebar && FocusState.key==root.focus-key {self.focus();}}
}
component ModeChoice inherits ComboBox {
    enabled: FocusState.ready && !FocusState.closing && !FocusState.modal && !FocusState.sidebar;
    private property <int> epoch: FocusState.restore-epoch;
    changed has-focus => { if self.has-focus { FocusState.key = 15; } }
    changed epoch => { if !FocusState.modal && FocusState.key == 15 { self.focus(); } }
}
component Caption inherits Text {
    vertical-stretch: 0;
    color: Palette.foreground;
    wrap: word-wrap;
}
export struct NavigationRow { index:int, label:string, enabled:bool }
export struct CollectionPreview { index:int, title:string, caption:string, available:bool, stories:[StoryRow] }
component Navigation inherits FocusScope {
    in property <[NavigationRow]> collections;
    in property <[NavigationRow]> shelves;
    callback navigate(int);
    in property <bool> french;
    in property <bool> compact;
    callback close();
    callback open-panel(int);
    public function activate() { close-navigation.focus(); }
    public function restore(key: int) {
        FocusState.key = key;
        FocusState.restore-epoch += 1;
    }
    key-pressed(event) => {
        if root.compact && event.text == Key.Escape { root.close(); return accept; }
        if root.compact && event.text == Key.Tab {
            if event.modifiers.shift && close-navigation.has-focus { settings-action.focus(); return accept; }
            if !event.modifiers.shift && settings-action.has-focus { close-navigation.focus(); return accept; }
        }
        return reject;
    }
    Rectangle { width: parent.width; height: parent.height; background: Palette.alternate-background; }
    ScrollView {
        width: parent.width; height: parent.height;
        content-width: self.visible-width;
        content-height: nav-layout.preferred-height;
        nav-layout := VerticalBox {
            height: self.preferred-height;
            padding: 14px; spacing: 10px;
            Caption { text: "Librairii"; font-size: 21px; font-weight: 700; }
            close-navigation := Action { visible: root.compact; height: root.compact ? 32px : 0px; focus-key: 201; text: root.french ? "Fermer la navigation" : "Close navigation"; clicked => { root.close(); } }
            library-action := Action { focus-key: 202; text: root.french ? "Bibliothèque" : "Library"; clicked => { root.open-panel(0); } }
            Caption { text: root.french ? "COLLECTIONS" : "COLLECTIONS"; font-weight: 600; }
            ListView { height: min(160px,root.collections.length * 34px); for entry in root.collections: Action { height: 32px; focus-key: 220 + entry.index; available: entry.enabled; text: entry.label; clicked => { root.navigate(entry.index); } } }
            Action { focus-key: 206; text: root.french ? "Gérer les Collections…" : "Manage Collections…"; available: FocusState.ready; clicked => { root.open-panel(9); } }
            Caption { text: root.french ? "ÉTAGÈRES" : "SHELVES"; font-weight: 600; }
            ListView { height: min(160px,root.shelves.length * 34px); for entry in root.shelves: Action { height: 32px; focus-key: 220 + entry.index; available: entry.enabled; text: entry.label; clicked => { root.navigate(entry.index); } } }
            tags-action := Action { focus-key: 203; text: root.french ? "Étiquettes" : "Tags"; clicked => { root.open-panel(1); } }
            history-action := Action { focus-key: 204; text: root.french ? "Historique" : "History"; clicked => { root.open-panel(4); } }
            Rectangle { height: 1px; background: Palette.border; }
            Caption { text: root.french ? "Catalogue officiel" : "Official catalog"; font-weight: 600; }
            Caption { text: root.french ? "Métadonnées facultatives. Vos archives restent locales." : "Optional metadata. Your archives stay local."; }
            settings-action := Action { focus-key: 205; text: root.french ? "Réglages…" : "Settings…"; clicked => { root.open-panel(5); } }
        }
    }
}
export component DesktopWindow inherits Window {
    title: "Librairii";
    preferred-width: 1180px; preferred-height: 760px;
    min-width: 560px; min-height: 400px;
    background: Palette.background;
    out property <brush> observed-foreground: Palette.foreground;
    out property <brush> observed-background: Palette.background;
    out property <brush> observed-control-foreground: Palette.control-foreground;
    out property <brush> observed-control-background: Palette.control-background;
    out property <brush> observed-selection-foreground: Palette.selection-foreground;
    out property <brush> observed-selection-background: Palette.selection-background;
    in property <bool> french;
    in property <string> status;
    in property <bool> pending;
    in property <float> progress;
    in property <bool> indeterminate;
    out property <length> observed-browser-height: browser.height;
    out property <length> observed-story-row-height: browser.mounted-row-height;
    out property <length> observed-approved-height: workspace-panel.approved-height;
    out property <length> observed-review-height: workspace-panel.review-height;
    public function focus-review() { workspace-panel.focus-review(); }
    public function focus-browser() { if root.workspace { workspace-panel.focus-approved(); } else { browser.focus(); } }
    out property <bool> close-focused: close-dialog-button.has-focus;
    out property <bool> attribution-focused: attribution-button.has-focus;
    out property <bool> query-focused: search-entry.has-focus;
    out property <bool> text-edit-focused: !root.closing && ((!root.modal && search-entry.has-focus) || (root.dialog == 8 && filters.first-focused) || (root.dialog == 10 && tag-manager.editing) || (root.dialog == 13 && collection-manager.editing));
    public function focus-search() { search-entry.focus(); }
    public function edit-search(action: EditAction) {
        if !FocusState.modal && !FocusState.closing && search-entry.has-focus {
            if action == EditAction.undo { search-entry.undo(); }
            else if action == EditAction.redo { search-entry.redo(); }
            else if action == EditAction.cut { search-entry.cut(); }
            else if action == EditAction.copy { search-entry.copy(); }
            else if action == EditAction.paste { search-entry.paste(); }
            else { search-entry.select-all(); }
        }
        else if !root.closing && root.dialog == 8 { filters.edit(action); }
        else if !root.closing && root.dialog == 10 { tag-manager.edit(action); }
        else if !root.closing && root.dialog == 13 { collection-manager.edit(action); }
    }
    in-out property <int> dialog;
    in-out property <bool> collection-busy;
    in property <[string]> collection-definitions;
    in property <[CollectionChoice]> collection-choices;
    in-out property <int> collection-index;
    in-out property <string> collection-name;
    in property <string> collection-notice;
    in property <string> collection-status;
    in property <string> collection-criteria;
    in property <string> collection-union-summary;
    in property <string> collection-impact;
    in-out property <bool> collection-replacing;
    in property <bool> collection-creating;
    in property <bool> collection-openable;
    in property <bool> collection-move-up;
    in property <bool> collection-move-down;
    in property <bool> collection-union-available;
    in property <bool> collection-union-active;
    in property <bool> collection-union-selected;
    in property <bool> collection-impact-previous;
    in property <bool> collection-impact-next;
    callback select-collection(int);
    callback save-collection();
    callback duplicate-collection();
    callback move-collection(int);
    callback open-collection();
    callback replace-collection();
    callback delete-collection();
    callback edit-current-collection-query();
    callback edit-saved-collection-query();
    callback toggle-collection-union(int);
    callback toggle-selected-collection-union();
    callback open-collection-union();
    callback save-collection-union();
    callback confirm-collection-change();
    callback cancel-collection-change();
    callback collection-impact-page(int);
    public function focus-collection-name() { collection-manager.focus-name(); }
    public function focus-collection-union() { collection-manager.focus-union(); }
    out property <bool> collection-union-focused: collection-manager.union-focused;
    out property <length> collection-union-window-y: collection-manager.union-window-y;
    out property <length> collection-union-height: collection-manager.union-height;
    public function show-collection-confirmation() { if root.dialog == 13 { root.dialog=14;dialog-scroll.content-y=0px;cancel-collection.focus(); } }
    public function finish-collection-confirmation() { root.dialog=13;collection-manager.activate(); }
    out property <bool> collection-cancel-focused: cancel-collection.has-focus;
    out property <bool> collection-invoker-focused: root.collection-replacing ? collection-manager.replace-focused : collection-manager.delete-focused;
    private property <int> assignment-parent;
    in-out property <bool> tag-busy;
    in property <bool> assignment-return-details;
    callback edit-tags();
    callback refresh-assignments();
    callback assignment-edit(int,int);
    callback select-tag-definition(int);
    callback select-tag-value(int);
    callback save-tag-definition();
    callback save-tag-value();
    callback move-tag-definition(int);
    callback move-tag-value(int);
    callback delete-tag-definition();
    callback delete-tag-value();
    callback confirm-tag-delete();
    callback cancel-tag-delete();
    in property <[string]> tag-definitions;
    in property <[string]> tag-values;
    in property <[AssignmentRow]> assignment-rows;
    in property <string> assignment-summary;
    in property <string> tag-notice;
    in property <string> tag-source;
    in property <bool> tag-editable;
    in property <bool> tag-move-up;
    in property <bool> tag-move-down;
    in property <bool> tag-value-move-up;
    in property <bool> tag-value-move-down;
    in property <bool> tag-choice;
    in property <bool> tag-creating;
    in-out property <int> tag-definition-index;
    in-out property <int> tag-value-index;
    in-out property <string> tag-key;
    in-out property <string> tag-label;
    in-out property <string> tag-color;
    in-out property <int> tag-kind;
    in-out property <string> tag-value-key;
    in-out property <string> tag-value-label;
    in property <string> tag-impact;
    in property <bool> tag-delete-value;
    out property <bool> tag-delete-cancel-focused: cancel-tag.has-focus;
    out property <bool> tag-delete-invoker-focused: root.tag-delete-value ? tag-manager.delete-value-focused : tag-manager.delete-definition-focused;
    public function focus-tag-label() { tag-manager.focus-label(); }
    in property <string> edit-tags-label;
    in property <bool> edit-tags-enabled;
    in property <string> bulk-summary;
    public function focus-clear-bulk() { clear-bulk-button.focus(); }
    out property <bool> clear-bulk-focused: clear-bulk-button.has-focus;
    callback toggle-bulk(int);
    callback clear-bulk();
    in property <bool> detail-flag-checked;
    in property <bool> detail-flag-enabled;
    in property <bool> panel-flag-checked;
    in property <bool> panel-flag-enabled;
    in property <bool> bulk-flag-checked;
    in property <bool> bulk-flag-enabled;
    in property <string> panel-flag-summary;
    in property <string> panel-flag-target-label;
    in property <string> bulk-flag-summary;
    in property <string> flag-notice;
    in property <bool> flag-pending;
    in property <bool> flag-undo-enabled;
    callback detail-flag-change(bool);
    callback panel-flag-change(bool);
    callback bulk-flag-change(bool);
    callback undo-flags();
    callback dismiss-flag-feedback();
    public function focus-detail-flag() { dialog-inspector.focus-flag(); }
    public function focus-panel-flag() { side-inspector.focus-flag(); }
    public function focus-bulk-flag() { bulk-flags.focus-control(1); }
    private property <int> bulk-flag-focus: 1;
    out property <bool> detail-flag-focused: dialog-inspector.flag-focused;
    out property <bool> panel-flag-focused: side-inspector.flag-focused;
    out property <bool> bulk-flag-undo-focused: bulk-flags.undo-focused;
    public function focus-bulk-story(index:int) { if root.workspace { workspace-panel.focus-bulk(index); } else if index >= root.story-count { FocusState.key= -1002 - index * 3;FocusState.restore-epoch+=1; } else { browser.focus-bulk(index); } }
    out property <int> preview-focused-key: !root.modal && !FocusState.sidebar && FocusState.key < 0 ? FocusState.preview-focused-key : 0;
    public function show-assignments() { root.assignment-parent=root.dialog; if root.dialog == 0 { root.invoker=FocusState.key; } root.dialog=11; dialog-scroll.content-y=0px; assignments.activate(); }
    public function show-tag-confirmation() { if root.dialog == 10 { root.dialog=12; cancel-tag.focus(); } }
    public function finish-tag-confirmation() { root.dialog=10; tag-manager.activate(); }

    out property <bool> modal: root.dialog != 0;
    private property <int> invoker;
    in property <int> startup-phase: 3;
    changed startup-phase => { FocusState.ready = root.startup-phase == 3; }
    in property <bool> commit-pending;
    in-out property <bool> closing;
    changed closing => { FocusState.closing = root.closing; }
    callback change-language(string);
    changed modal => { FocusState.modal = root.modal; }
    changed sidebar-open => { FocusState.sidebar = root.compact && root.sidebar-open; }
    changed compact => {
        FocusState.sidebar = root.compact && root.sidebar-open;
        if root.compact && !root.sidebar-open && !root.modal && FocusState.key >= 200 { navigation-button.focus(); }
    }
    public function open-dialog(kind: int) {
        if root.dialog == 0 {
            root.invoker = FocusState.key;
            root.dialog = kind;
            dialog-scroll.content-y = 0px;
            if kind == 3 { dialog-inspector.reset(); root.request-details(); }
            FocusState.modal = true;
            if kind == 2 { english-button.focus(); } else if kind == 8 { filters.activate(); } else if kind == 10 { tag-manager.activate(); } else if kind == 13 { collection-manager.activate(); } else { close-dialog-button.focus(); }
        }
    }
    public function close-dialog() {
        if root.closing || root.detail-pending || root.tag-busy || root.collection-busy { return; }
        if root.dialog == 14 { root.cancel-collection-change();root.dialog=13;collection-manager.focus-invoker(root.collection-replacing);return; }
        if root.dialog == 12 { root.cancel-tag-delete();root.dialog=10;tag-manager.focus-delete(root.tag-delete-value);return; }
        if root.dialog == 11 && root.assignment-parent == 3 && root.assignment-return-details { root.dialog=3;edit-tags-button.focus();root.request-details();return; }
        if root.dialog == 9 { root.dialog = 3; remove-story-button.focus(); return; }
        if root.dialog == 3 { root.dismiss-flag-feedback(); }
        root.dialog = 0;
        FocusState.modal = false;
        FocusState.key = root.invoker;
        if root.compact && root.sidebar-open { navigation.restore(root.invoker); }
        else if root.compact && root.invoker >= 200 { navigation-button.focus(); }
        else if root.invoker == 10 && !root.compact { library-button.focus(); }
        else if root.invoker == 32 && root.wide && !root.workspace { side-inspector.focus-current(); }
        else if root.invoker == 32 { root.focus-browser(); }
        else if root.invoker == 31 { root.focus-browser(); }
        else if root.invoker == 23 && root.bulk-summary == "" { root.focus-browser(); }
        else if root.invoker == 24 { if root.bulk-summary == "" || (!root.bulk-flag-enabled && !root.flag-undo-enabled) { root.focus-browser(); } else { bulk-flags.focus-control(root.bulk-flag-focus); } }
        else if root.invoker == 30 { search-entry.focus(); }
        else { FocusState.restore-epoch += 1; }
    }
    public function request-quit() { if root.detail-pending || root.tag-busy || root.collection-busy { return; } if root.closing { return; } if root.pending { root.open-dialog(7); } else { root.quit(); } }
    in-out property <bool> compact;
    in-out property <bool> wide: true;
    changed wide => { if !root.wide && !root.modal && FocusState.key == 32 { browser.focus(); } }
    in-out property <bool> sidebar-open;
    in-out property <int> panel;
    in-out property <string> query;
    out property <int> focused-key: FocusState.key;
    in property <[NavigationRow]> collection-rows;
    in property <[NavigationRow]> shelf-rows;
    in property <string> scope-title;
    callback navigate-group(int);
    in property <bool> workspace;
    in property <[string]> sources;
    in-out property <[ProposalRow]> proposals;
    in property <int> decisions;
    callback decide(int,int);
    callback apply-decisions();
    in property <[StoryGroup]> story-groups;
    in property <int> story-count;
    in property <int> columns: 1;
    in-out property <int> mode;
    in-out property <int> selected-index: -1;
    in property <StoryRow> selected-story;
    callback request-details();
    callback begin-removal();
    callback remove-story();
    in-out property <bool> detail-pending;
    in property <string> removal-title;
    in property <string> removal-error;
    public function scroll-details(key:string) { dialog-inspector.scroll(key); }
    out property <bool> inspector-technical-focused: side-inspector.technical-focused;
    public function focus-inspector-technical() { side-inspector.focus-technical(); }
    public function focus-details-technical() { dialog-inspector.focus-technical(); }
    out property <length> details-scroll-position: dialog-inspector.scroll-position;
    out property <bool> removal-keep-focused: keep-story.has-focus;
    public function confirm-removal() { if root.dialog == 3 { root.dialog = 9; keep-story.focus(); } }
    public function complete-removal() { root.detail-pending = false; root.dialog = 3; root.close-dialog(); }

    in property <string> counts;
    in property <bool> previous-enabled;
    in property <bool> next-enabled;
    callback select-story(int);
    callback mode-selected(int);
    callback change-page(int);
    in property <[CollectionPreview]> collection-previews;
    in property <bool> group-previous;
    in property <bool> group-next;
    callback change-group-page(int);
    public function scroll-library-end() { library-scroll.content-y=min(0px,library-scroll.visible-height - library-scroll.content-height); }
    function reveal-library(y:length,h:length) {
        let top=library-scroll.absolute-position.y;
        library-scroll.content-y=max(min(0px,library-scroll.visible-height - library-scroll.content-height),min(0px,library-scroll.content-y+(y<top ? top - y : y+h>top+library-scroll.visible-height ? top+library-scroll.visible-height - y - h : 0px)));
    }
    in property <bool> back-enabled;
    in property <bool> forward-enabled;
    callback history-step(int);
    callback quit();
    callback request-panel(int);
    callback search(string);
    in property <[FilterRow]> filter-rows;
    in property <[ActiveFilterRow]> active-filter-rows;
    in property <string> active-filter-summary;
    in property <string> filter-label;
    in-out property <int> sort-index;
    in property <bool> sort-manual-available;
    out property <int> displayed-sort-index: filters.displayed-sort-index;
    out property <bool> filter-clear-focused: filters.clear-focused;
    out property <length> filter-clear-window-y: filters.clear-window-y;
    out property <length> filter-clear-height: filters.clear-height;
    out property <length> dialog-viewport-y: dialog-scroll.absolute-position.y;
    out property <length> dialog-viewport-height: dialog-scroll.visible-height;
    callback filter-search(string);
    in-out property <string> filter-search-query;
    callback filter-edit(int,int);
    callback filter-collapse(int);
    callback filter-remove(int);
    callback filter-clear();
    callback filter-clear-tags();
    callback sort-selected(int);
    public function focus-filters() { filters.activate(); }
    function reveal-dialog(y:length, height:length) {
        let top=dialog-scroll.absolute-position.y;
        let delta=y<top ? top - y : y+height>top+dialog-scroll.visible-height ? top+dialog-scroll.visible-height - y - height : 0px;
        dialog-scroll.content-y=max(min(0px,dialog-scroll.visible-height - dialog-scroll.content-height),min(0px,dialog-scroll.content-y+delta));
    }
    public function open-sidebar() { if !root.modal { root.sidebar-open = true; navigation.activate(); } }
    public function close-sidebar() { root.sidebar-open = false; navigation-button.focus(); }
    public function show-panel(kind: int) {
        if kind == 0 { root.panel = 0; root.request-panel(kind); if root.compact { root.close-sidebar(); } }
        else if kind == 5 { root.open-dialog(2); }
        else if kind == 8 { root.open-dialog(3); }
        else if kind == 1 { root.open-dialog(10);root.request-panel(kind); }
        else if kind == 9 { root.open-dialog(13);root.request-panel(kind); }
        else { root.panel = kind; root.open-dialog(6); root.request-panel(kind); }
    }
    in property <bool> platform-menu: false;
    if !root.platform-menu: MenuBar {
        Menu {
            title: "Navigation";
            MenuItem { title: root.french ? "Retour" : "Back"; enabled: root.back-enabled && !root.modal; shortcut: @keys(Alt + LeftArrow); activated => { root.history-step(-1); } }
            MenuItem { title: root.french ? "Suivant" : "Forward"; enabled: root.forward-enabled && !root.modal; shortcut: @keys(Alt + RightArrow); activated => { root.history-step(1); } }
        }
        Menu {
            title: "Librairii";
            MenuItem { title: root.french ? "Réglages…" : "Settings…"; shortcut: @keys(Control + ","); activated => { root.show-panel(5); } }
            MenuItem { title: root.french ? "À propos de Slint…" : "About Slint…"; activated => { root.open-dialog(1); } }
            MenuItem { title: root.french ? "Quitter" : "Quit"; shortcut: @keys(Control + Q); activated => { root.request-quit(); } }
        }
    }
    base := VerticalBox {
        padding: 0px; spacing: 0px;
        HorizontalBox {
            padding: root.compact ? 4px : 10px; spacing: 8px;
            navigation-button := Action { width: root.compact ? 96px : 0px; focus-key: 10; text: root.french ? "Navigation" : "Navigation"; visible: root.compact; clicked => { root.open-sidebar(); } }
            Image { visible: !root.compact; source: @image-url("../assets/library.svg"); width: 28px; height: 28px; }
            library-button := Action { focus-key: 11; text: root.french ? "Bibliothèque" : "Library"; clicked => { root.show-panel(0); } }
            Action { focus-key: 21; text: root.french ? "Étiquettes" : "Tags"; clicked => { root.show-panel(1); } }
            Action { focus-key: 12; text: root.french ? "Importer…" : "Import…"; clicked => { root.show-panel(2); } }
            Action { focus-key: 13; text: root.french ? "Exporter…" : "Export…"; clicked => { root.show-panel(3); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: Palette.border; }
        if root.startup-phase != 3: HorizontalBox {
            padding: 10px;
            Caption { text: root.status; horizontal-stretch: 1; accessible-live-region: polite; }
            Action { focus-key: 18; visible: root.startup-phase != 4; width: root.startup-phase == 4 ? 0px : 110px; text: root.startup-phase == 2 ? (root.french ? "Récupération…" : "Recovery…") : (root.french ? "Configurer…" : "Set up…"); clicked => { root.open-dialog(root.startup-phase == 2 ? 5 : 4); } }
        }
        Rectangle {
            vertical-stretch: 1;
            main := FocusScope {
                x: root.compact ? 0px : 216px;
                width: parent.width - self.x; height: parent.height;
                enabled: !root.compact || !root.sidebar-open;
                VerticalBox {
                    padding: root.compact ? 8px : 20px; spacing: 8px;
                    HorizontalBox { padding: 0px; spacing: 8px;
                        Caption { text: root.scope-title != "" ? root.scope-title : root.panel == 0 ? (root.french ? "Bibliothèque" : "Library") : root.panel == 4 ? (root.french ? "Historique" : "History") : root.panel == 5 ? (root.french ? "Réglages" : "Settings") : (root.french ? "Bibliothèque" : "Library"); horizontal-stretch: 1; font-size: root.compact ? 20px : 24px; font-weight: 600; }
                        Caption { text: root.counts; horizontal-stretch: 0; }
                    }
                    HorizontalBox { padding: 0px; spacing: 8px;
                        search-entry := SearchField { horizontal-stretch: 1; text <=> root.query; accessible-label: root.french ? "Rechercher des histoires" : "Search stories"; placeholder-text: root.french ? "Rechercher des histoires" : "Search stories"; edited => { root.search(self.text); } }
                        ModeChoice { horizontal-stretch: 0; width: root.compact ? 180px : 230px; accessible-label: root.french ? "Présentation" : "Presentation"; model: root.french ? ["Liste", "Petites couvertures", "Grandes couvertures"] : ["List", "Small covers", "Large covers"]; current-index <=> root.mode; selected(_) => { root.mode-selected(self.current-index); } }
                        Action { focus-key: 22; available: root.startup-phase == 3; text: root.filter-label != "" ? root.filter-label : (root.french ? "Filtres…" : "Filters…"); clicked => { root.open-dialog(8); } }
                    }
                    if root.active-filter-summary != "": Text { vertical-stretch: 0; height: 24px; text: root.active-filter-summary; accessible-label: (root.french ? "Filtres actifs · " : "Active filters · ") + self.text; overflow: elide; color: Palette.foreground; }
                    HorizontalBox { visible: root.bulk-summary != ""; height: self.visible ? 32px : 0px; padding: 0px; spacing: 8px;
                        Caption { text: root.bulk-summary; accessible-live-region: polite; horizontal-stretch: 1; }
                        clear-bulk-button := Action { focus-key: 23; available: root.bulk-summary != ""; text: root.french ? "Effacer la sélection" : "Clear selection"; clicked => { root.clear-bulk(); } }
                    }
                    bulk-flags := FlagControl { visible: root.bulk-summary != ""; height: self.visible ? self.preferred-height : 0px; french: root.french; active: !root.modal && !root.closing && !FocusState.sidebar; available: root.bulk-flag-enabled; checked: root.bulk-flag-checked; pending: root.flag-pending; can-undo: root.flag-undo-enabled; inline-summary: true; title: root.french ? "Histoires sélectionnées" : "Selected stories"; summary: root.bulk-flag-summary; notice: root.flag-notice;
                        change(value) => { root.bulk-flag-change(value); } undo => { root.undo-flags(); } focused(kind) => { root.bulk-flag-focus=kind;FocusState.key=24; }
                    }
                    body := HorizontalBox { padding: 0px; spacing: 12px; vertical-stretch: 1; min-height: 0px;
                        VerticalBox { padding: 0px; spacing: root.status == "" ? 0px : 8px; max-width: root.workspace ? 0px : 100000px; visible: !root.workspace;
                            Caption { accessible-live-region: polite; text: root.status; visible: root.status != ""; height: root.status == "" ? 0px : self.preferred-height; }
                            library-scroll := ScrollView { content-width: self.visible-width; content-height: library-layout.preferred-height;
                                library-layout := VerticalBox { height: self.preferred-height; padding: 0px; spacing: 8px;
                                    browser := StoryBrowser { height: library-scroll.visible-height; french: root.french; visible: !root.workspace; enabled: root.startup-phase == 3 && !root.closing && !root.workspace && !root.modal && !FocusState.sidebar; focus-entered => { FocusState.key = 31; } groups: root.story-groups; count: root.story-count; columns: root.columns; mode: root.mode; label: root.french ? "Toutes les histoires" : "All stories"; selected-index <=> root.selected-index; select(index) => { root.select-story(index); } toggle(index) => { root.toggle-bulk(index); } reveal(y,h) => {root.reveal-library(y,h);} }
                                    for preview in root.collection-previews: VerticalBox { padding: 8px; spacing: 8px;
                                        Caption { text: preview.title; font-weight: 600; }
                                        Caption { text: preview.caption; }
                                        Action { focus-key: -1000 - preview.index * 3; available: preview.available; text: root.french ? "Tout afficher · " + preview.title : "View all · " + preview.title; clicked => {root.navigate-group(preview.index);} changed has-focus => {if self.has-focus {FocusState.key=self.focus-key;root.reveal-library(self.absolute-position.y,self.height);}} }
                                        for story in preview.stories: HorizontalBox { padding: 0px; spacing: 8px; height: 58px;
                                            Image { width: 48px; height: 50px; source: story.cover.width > 0 ? story.cover : @image-url("../assets/library.svg"); image-fit: contain; opacity: story.broken ? 0.45 : 1; }
                                            Rectangle { horizontal-stretch: 1; height: 54px; border-width: preview-inspect.has-focus ? 2px : 0px; border-color: Palette.foreground; border-radius: 4px; accessible-role: none;
                                            preview-inspect := Action { x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px; focus-key: -1001 - story.index * 3; text: (root.selected-story.uuid==story.uuid ? "▶ " : "") + story.title + (story.warning == "" ? "" : " · " + story.warning); accessible-item-selectable: true; accessible-item-selected: root.selected-story.uuid==story.uuid; accessible-label: (root.selected-story.uuid==story.uuid ? (root.french ? "Histoire inspectée · " : "Inspected story · ") : "") + story.title + (story.warning == "" ? "" : " · " + story.warning); clicked => {root.select-story(story.index);} changed has-focus => {if self.has-focus {FocusState.key=self.focus-key;FocusState.preview-focused-key=self.focus-key;root.reveal-library(self.absolute-position.y,self.height);}else if FocusState.preview-focused-key==self.focus-key {FocusState.preview-focused-key=0;}} }
                                            }
                                            Rectangle { width: 34px; height: 34px; border-width: preview-check.has-focus ? 2px : 0px; border-color: Palette.foreground; border-radius: 4px; accessible-role: none;
                                            preview-check := PreviewBulk { x: 3px; y: 3px; width: 28px; height: 28px; focus-key: -1002 - story.index * 3; checked: story.bulk; text: ""; accessible-label: (story.bulk ? (root.french ? "Désélectionner · " : "Deselect · ") : (root.french ? "Sélectionner · " : "Select · ")) + story.title; toggled => {root.toggle-bulk(story.index);} reveal(y,h)=>{root.reveal-library(y,h);} }
                                            }
