{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private fixed-shape JSONv1 Studio text and optional metadata original-to-derivative manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bundle",
    "files"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "bundle": {
      "const": "go-1.26.5-json-v1-studio"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "kind",
          "recipe",
          "sources",
          "notices"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "authored",
              "translated",
              "generated"
            ]
          },
          "recipe": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "header_sha256",
                "selection"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:]).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "header_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "selection": {
                  "enum": [
                    "go-json-utf16",
                    "go-json-utf8-and-trim-boundary",
                    "go-trim-space",
                    "json-v1-decoder-order",
                    "json-v1-field-fold",
                    "json-v1-fixed-reducer",
                    "json-v1-scanner",
                    "studio-text-and-optional-metadata-boundary",
                    "unicode15-is-space",
                    "unicode15-simple-fold-and-white-space"
                  ]
                }
              }
            },
            "uniqueItems": true
          },
          "notices": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "LICENSE-GO-BSD.txt",
                "PATENTS-GO.txt",
                "LICENSE-UNICODE-V3.txt"
              ]
            }
          }
        }
      }
    }
  },
  "$comment": "Owner5 checker additionally pins this exact version2 index/schema, exact actual released private-file set, repository-relative regular/no-alias paths, source/header identities and per-path selection scopes. Evidence-only inputs cannot authorize production derivatives. Authored glue/tests have empty sources/notices; translated/generated records have nonempty exact source uses, preserved original copyright lines, changed-representation recipe and complete selection notice union. Schema cannot prove semantics, resource bounds or effects."
}
