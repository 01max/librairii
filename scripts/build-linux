#!/bin/sh
set -eu

project_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$project_root"

if ! command -v docker >/dev/null 2>&1; then
    printf 'make linux requires Docker with Buildx (included in Docker Desktop).\n' >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    printf 'Docker is not available. Start Docker Desktop or your Docker engine, then retry make linux.\n' >&2
    exit 1
fi
if ! docker buildx version >/dev/null 2>&1; then
    printf 'make linux requires the Docker Buildx plugin.\n' >&2
    exit 1
fi

node_version="$(tr -d '[:space:]' < .nvmrc)"
wails_version="$(tr -d '[:space:]' < .wails-version)"
version="$(tr -d '[:space:]' < VERSION)"

docker buildx build \
    --platform linux/amd64 \
    --file build/linux/Dockerfile \
    --build-arg "NODE_VERSION=$node_version" \
    --build-arg "WAILS_VERSION=$wails_version" \
    --output type=local,dest=build/bin \
    .

printf 'Linux executable: build/bin/Librairii\n'
printf 'Linux archive: build/bin/Librairii-%s-linux-amd64.tar.gz\n' "$version"
printf 'Linux checksum: build/bin/Librairii-%s-linux-amd64.tar.gz.sha256\n' "$version"
