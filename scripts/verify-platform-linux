#!/bin/sh
set -eu

project_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$project_root"

host_os="$(go env GOOS)"
host_arch="$(go env GOARCH)"
if [ "$host_os" != "linux" ] || [ "$host_arch" != "amd64" ]; then
    printf 'Linux release verification requires linux/amd64, got %s/%s\n' \
        "$host_os" "$host_arch" >&2
    exit 1
fi

version="$(tr -d '[:space:]' < VERSION)"
wails_cli="${WAILS:-$(go env GOPATH)/bin/wails}"
wails_version="$(tr -d '[:space:]' < .wails-version)"
if [ "$("$wails_cli" version | head -n 1)" != "$wails_version" ]; then
    printf 'Wails CLI must match %s\n' "$wails_version" >&2
    exit 1
fi

"$wails_cli" build \
    -clean \
    -trimpath \
    -m \
    -nocolour \
    -nopackage \
    -platform linux/amd64 \
    -tags webkit2_41 \
    -o Librairii
find frontend/wailsjs/go -type f -exec chmod 644 {} +

binary="$project_root/build/bin/Librairii"
if [ ! -x "$binary" ]; then
    printf 'packaged Linux executable is missing: %s\n' "$binary" >&2
    exit 1
fi
if ! file "$binary" | grep -q 'ELF 64-bit.*x86-64'; then
    printf 'packaged Linux executable is not an amd64 ELF binary\n' >&2
    exit 1
fi
if ldd "$binary" | grep -q 'not found'; then
    printf 'packaged Linux executable has unresolved dynamic dependencies\n' >&2
    ldd "$binary" >&2
    exit 1
fi

verification_root="$(mktemp -d "${TMPDIR:-/tmp}/librairii-linux-release.XXXXXX")"
data_root="$verification_root/application-data"
headless_root="$verification_root/headless-data"
export_destination="$verification_root/export"
acceptance_checkpoints="$verification_root/checkpoints.log"
acceptance_source="$project_root/internal/inspection/testfixture/testdata/generic.7z"
event_log="$data_root/logs/events.jsonl"
mkdir -p "$data_root" "$headless_root" "$export_destination"

cleanup() {
    case "$(basename -- "$verification_root")" in
        librairii-linux-release.*)
            rm -rf -- "$verification_root"
            ;;
    esac
}
trap cleanup EXIT HUP INT TERM

timeout 30s xvfb-run -a env \
    LIBGL_ALWAYS_SOFTWARE=1 \
    LIBRAIRII_DATA_ROOT="$data_root" \
    LIBRAIRII_PACKAGED_ACCEPTANCE=1 \
    LIBRAIRII_ACCEPTANCE_SOURCE="$acceptance_source" \
    LIBRAIRII_ACCEPTANCE_DESTINATION="$export_destination" \
    LIBRAIRII_ACCEPTANCE_CHECKPOINTS="$acceptance_checkpoints" \
    "$binary"

expected_checkpoints="$verification_root/expected-checkpoints.log"
printf '%s\n' \
    scenario_started \
    import_queued \
    import_succeeded \
    collection_loaded \
    export_prepared \
    export_queued \
    export_succeeded \
    reveal_succeeded \
    complete > "$expected_checkpoints"
if ! cmp -s "$expected_checkpoints" "$acceptance_checkpoints"; then
    printf 'packaged Linux bindings did not complete the acceptance scenario\n' >&2
    diff -u "$expected_checkpoints" "$acceptance_checkpoints" >&2 || true
    exit 1
fi
for state in \
    import:queued \
    import:running \
    import:succeeded \
    export:queued \
    export:running \
    export:succeeded
do
    if ! grep -q "\"state\":\"$state\"" "$event_log"; then
        printf 'packaged Linux progress log is missing %s\n' "$state" >&2
        exit 1
    fi
done
if [ "$(find "$export_destination" -type f | wc -l | tr -d ' ')" -ne 1 ]; then
    printf 'packaged Linux export did not publish exactly one archive\n' >&2
    exit 1
fi

GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$data_root" \
        -expect-stories 1 \
        -expect-shelves 0
GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go run ./cmd/release-smoke -root "$headless_root"
GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$headless_root" \
        -expect-stories 1 \
        -expect-shelves 3

launch_number=0
event_count() {
    event_name="$1"
    awk -v event="\"event\":\"$event_name\"" \
        'index($0, event) { count++ } END { print count + 0 }' \
        "$event_log"
}
launch_packaged_application() {
    launch_number=$((launch_number + 1))
    launch_log="$verification_root/launch-$launch_number.log"
    started_before="$(event_count runtime_started)"
    stopped_before="$(event_count runtime_stopped)"

    xvfb-run -a env \
        LIBGL_ALWAYS_SOFTWARE=1 \
        LIBRAIRII_DATA_ROOT="$data_root" \
        LIBRAIRII_ACCEPTANCE_LOG=1 \
        LIBRAIRII_SMOKE_EXIT=1 \
        LIBRAIRII_SMOKE_HOLD_MS=1200 \
        "$binary" > "$launch_log" 2>&1

    if ! grep -q 'frontend:rendered' "$launch_log"; then
        printf 'packaged Linux frontend did not report a completed render\n' >&2
        cat "$launch_log" >&2
        exit 1
    fi
    started_after="$(event_count runtime_started)"
    stopped_after="$(event_count runtime_stopped)"
    if [ "$started_after" -ne $((started_before + 1)) ] ||
        [ "$stopped_after" -ne $((stopped_before + 1)) ]; then
        printf 'packaged Linux lifecycle did not start and stop cleanly\n' >&2
        exit 1
    fi
    if ! tail -n 1 "$event_log" |
        grep -q '"event":"runtime_stopped","state":"stopped"'; then
        printf 'packaged Linux lifecycle did not end in a clean shutdown\n' >&2
        exit 1
    fi
}

launch_packaged_application
launch_packaged_application

GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$data_root" \
        -expect-stories 1 \
        -expect-shelves 0
GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go test . -count=1
GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go test ./internal/platform \
        -run '^(TestProductionRuntimeDialogsUseHostNativeAdapters|TestRuntimeDialogsUseNativeMultiFilePicker|TestRuntimeDialogsSupportSingleFileAndDirectory|TestRuntimeDialogsRevealOnlyValidatedDirectory|TestDestinationRevealerUsesPlatformFileManager)$' \
        -count=1
GOCACHE="${GOCACHE:-/tmp/librairii-go-cache}" \
    go test ./cmd/release-smoke \
        -run '^TestReleaseSmokeCoversTheCompleteHeadlessComposition$' \
        -count=1

artifact="build/bin/Librairii-${version}-linux-amd64.tar.gz"
tar \
    --sort=name \
    --mtime='@0' \
    --owner=0 \
    --group=0 \
    --numeric-owner \
    -czf "$artifact" \
    -C build/bin \
    Librairii
(
    cd "$(dirname -- "$artifact")"
    artifact_name="$(basename -- "$artifact")"
    sha256sum "$artifact_name" > "$artifact_name.sha256"
    sha256sum -c "$artifact_name.sha256"
)

printf 'Linux platform acceptance passed: build, render, SQLite, native adapters, smoke\n'
printf 'Linux artifact: %s\n' "$artifact"
