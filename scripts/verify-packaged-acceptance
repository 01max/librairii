#!/bin/sh
set -eu

project_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$project_root"

host_os="$(go env GOOS)"
host_arch="$(go env GOARCH)"
version="$(tr -d '[:space:]' < VERSION)"
artifact="build/bin/Librairii-${version}-${host_os}-${host_arch}.dmg"
if [ "$host_os" != "darwin" ]; then
    printf 'packaged acceptance requires macOS, got %s/%s\n' \
        "$host_os" "$host_arch" >&2
    exit 1
fi
if [ ! -f "$artifact" ] || [ ! -f "$artifact.sha256" ]; then
    printf 'packaged installer or checksum is missing\n' >&2
    exit 1
fi
(
    cd "$(dirname -- "$artifact")"
    /usr/bin/shasum -a 256 -c "$(basename -- "$artifact").sha256"
)

acceptance_root="$(mktemp -d /private/tmp/librairii-packaged-acceptance.XXXXXX)"
mount_point="$acceptance_root/mount"
install_root="$acceptance_root/Applications"
data_root="$acceptance_root/application-data"
headless_root="$acceptance_root/headless-data"
export_destination="$acceptance_root/export"
acceptance_checkpoints="$acceptance_root/checkpoints.log"
acceptance_source="$project_root/internal/inspection/testfixture/testdata/generic.7z"
installed_application="$install_root/Librairii.app"
mounted=0
application_pid=""

cleanup() {
    if [ -n "$application_pid" ]; then
        kill -TERM "$application_pid" 2>/dev/null || true
        wait "$application_pid" 2>/dev/null || true
    fi
    if [ "$mounted" -eq 1 ]; then
        /usr/bin/hdiutil detach "$mount_point" -quiet || true
    fi
    case "$acceptance_root" in
        /private/tmp/librairii-packaged-acceptance.*)
            rm -rf -- "$acceptance_root"
            ;;
    esac
}
trap cleanup EXIT HUP INT TERM

mkdir -p \
    "$mount_point" \
    "$install_root" \
    "$data_root" \
    "$headless_root" \
    "$export_destination"
/usr/bin/hdiutil attach \
    "$artifact" \
    -mountpoint "$mount_point" \
    -nobrowse \
    -readonly \
    -quiet
mounted=1
/usr/bin/ditto "$mount_point/Librairii.app" "$installed_application"
/usr/bin/codesign --verify --deep --strict "$installed_application"

application_binary="$installed_application/Contents/MacOS/Librairii"
clean_path="/usr/bin:/bin:/usr/sbin:/sbin"
event_log="$data_root/logs/events.jsonl"
acceptance_launch_log="$acceptance_root/acceptance-launch.log"
env -i \
    PATH="$clean_path" \
    LIBRAIRII_DATA_ROOT="$data_root" \
    LIBRAIRII_PACKAGED_ACCEPTANCE=1 \
    LIBRAIRII_ACCEPTANCE_SOURCE="$acceptance_source" \
    LIBRAIRII_ACCEPTANCE_DESTINATION="$export_destination" \
    LIBRAIRII_ACCEPTANCE_CHECKPOINTS="$acceptance_checkpoints" \
    "$application_binary" > "$acceptance_launch_log" 2>&1 &
application_pid=$!
(
    sleep 30
    kill -TERM "$application_pid" 2>/dev/null || true
) &
watchdog_pid=$!
if wait "$application_pid"; then
    acceptance_status=0
else
    acceptance_status=$?
fi
application_pid=""
kill -TERM "$watchdog_pid" 2>/dev/null || true
wait "$watchdog_pid" 2>/dev/null || true
if [ "$acceptance_status" -ne 0 ]; then
    printf 'packaged Wails acceptance scenario exited with %s\n' \
        "$acceptance_status" >&2
    cat "$acceptance_launch_log" >&2
    exit 1
fi

expected_checkpoints="$acceptance_root/expected-checkpoints.log"
printf '%s\n' \
    scenario_started \
    native_import_dialog_selected \
    import_queued \
    import_succeeded \
    collection_loaded \
    native_destination_dialog_selected \
    export_prepared \
    export_queued \
    export_succeeded \
    native_reveal_succeeded \
    reveal_succeeded \
    complete > "$expected_checkpoints"
if ! cmp -s "$expected_checkpoints" "$acceptance_checkpoints"; then
    printf 'packaged Wails bindings did not complete the acceptance scenario\n' >&2
    diff -u "$expected_checkpoints" "$acceptance_checkpoints" >&2 || true
    cat "$acceptance_launch_log" >&2
    exit 1
fi

for state in \
    import:queued \
    import:running \
    import:succeeded \
    export:queued \
    export:running \
    export:succeeded
do
    if ! grep -q "\"state\":\"$state\"" "$event_log"; then
        printf 'operation progress log is missing %s\n' "$state" >&2
        exit 1
    fi
done
if [ "$(find "$export_destination" -type f | wc -l | tr -d ' ')" -ne 1 ]; then
    printf 'packaged export did not publish exactly one archive\n' >&2
    exit 1
fi

GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$data_root" \
        -expect-stories 1 \
        -expect-shelves 0

GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go run ./cmd/release-smoke -root "$headless_root"
GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$headless_root" \
        -expect-stories 1 \
        -expect-shelves 3

launch_number=0
launch_packaged_application() {
    launch_number=$((launch_number + 1))
    launch_log="$acceptance_root/launch-$launch_number.log"
    started_before="$(grep -c '"event":"runtime_started"' "$event_log")"
    stopped_before="$(grep -c '"event":"runtime_stopped"' "$event_log")"

    env -i \
        PATH="$clean_path" \
        LIBRAIRII_DATA_ROOT="$data_root" \
        LIBRAIRII_ACCEPTANCE_LOG=1 \
        LIBRAIRII_SMOKE_EXIT=1 \
        LIBRAIRII_SMOKE_HOLD_MS=1200 \
        "$application_binary" > "$launch_log" 2>&1

    if ! grep -q 'frontend:rendered' "$launch_log"; then
        printf 'packaged frontend did not report a completed render\n' >&2
        exit 1
    fi
    started_after="$(grep -c '"event":"runtime_started"' "$event_log")"
    stopped_after="$(grep -c '"event":"runtime_stopped"' "$event_log")"
    if [ "$started_after" -ne $((started_before + 1)) ] ||
        [ "$stopped_after" -ne $((stopped_before + 1)) ]; then
        printf 'packaged lifecycle did not start and stop cleanly\n' >&2
        exit 1
    fi
    if ! tail -n 1 "$event_log" |
        grep -q '"event":"runtime_stopped","state":"stopped"'; then
        printf 'packaged lifecycle log did not end in a clean shutdown\n' >&2
        exit 1
    fi
}

launch_packaged_application
launch_packaged_application
GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go run ./cmd/foundation-smoke \
        -root "$data_root" \
        -expect-stories 1 \
        -expect-shelves 0

GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go test ./internal/platform \
        -run '^(TestProductionRuntimeDialogsUseHostNativeAdapters|TestRuntimeDialogsUseNativeMultiFilePicker|TestRuntimeDialogsSupportSingleFileAndDirectory|TestRuntimeDialogsRevealOnlyValidatedDirectory|TestDestinationRevealerUsesPlatformFileManager)$' \
        -count=1
GOCACHE="${GOCACHE:-/private/tmp/librairii-go-cache}" \
    go test ./cmd/release-smoke \
        -run '^TestReleaseSmokeCoversTheCompleteHeadlessComposition$' \
        -count=1
npm --prefix frontend run test:release

printf 'packaged acceptance passed: render, host-native dialogs, progress, reveal, persistence, shutdown\n'
