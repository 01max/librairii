#!/bin/sh
set -eu

project_root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$project_root"

host_os="$(go env GOOS)"
host_arch="$(go env GOARCH)"
if [ "$host_os" != "darwin" ]; then
    printf 'current installer build is implemented for the macOS host, got %s/%s\n' \
        "$host_os" "$host_arch" >&2
    exit 1
fi

version="$(tr -d '[:space:]' < VERSION)"
case "$version" in
    ''|*[!0-9.]*)
        printf 'VERSION must contain a dotted numeric release version\n' >&2
        exit 1
        ;;
esac

wails_cli="${WAILS:-$(go env GOPATH)/bin/wails}"
wails_version="$(tr -d '[:space:]' < .wails-version)"
if [ "$("$wails_cli" version | head -n 1)" != "$wails_version" ]; then
    printf 'Wails CLI must match %s\n' "$wails_version" >&2
    exit 1
fi

npm --prefix frontend run build
"$wails_cli" build -clean -trimpath -m -nocolour
find frontend/wailsjs/go -type f -exec chmod 644 {} +

application="build/bin/Librairii.app"
executable="$application/Contents/MacOS/Librairii"
if [ ! -x "$executable" ]; then
    printf 'packaged executable is missing: %s\n' "$executable" >&2
    exit 1
fi
/usr/bin/codesign --verify --deep --strict "$application"
/usr/bin/plutil -lint "$application/Contents/Info.plist"
bundle_version="$(
    /usr/bin/plutil \
        -extract CFBundleShortVersionString \
        raw \
        -o - \
        "$application/Contents/Info.plist"
)"
if [ "$bundle_version" != "$version" ]; then
    printf 'bundle version %s does not match release version %s\n' \
        "$bundle_version" "$version" >&2
    exit 1
fi
if ! file "$executable" | grep -q "Mach-O 64-bit executable $host_arch"; then
    printf 'packaged executable does not target %s\n' "$host_arch" >&2
    exit 1
fi

unexpected_dependencies="$(
    /usr/bin/otool -L "$executable" |
        tail -n +2 |
        awk '{print $1}' |
        grep -Ev '^(/System/Library/|/usr/lib/)' || true
)"
if [ -n "$unexpected_dependencies" ]; then
    printf 'release binary has unpackaged dynamic dependencies:\n%s\n' \
        "$unexpected_dependencies" >&2
    exit 1
fi

staging_root="$(mktemp -d /private/tmp/librairii-installer-build.XXXXXX)"
cleanup() {
    case "$staging_root" in
        /private/tmp/librairii-installer-build.*)
            rm -rf -- "$staging_root"
            ;;
    esac
}
trap cleanup EXIT HUP INT TERM

/usr/bin/ditto "$application" "$staging_root/Librairii.app"
ln -s /Applications "$staging_root/Applications"

artifact="build/bin/Librairii-${version}-${host_os}-${host_arch}.dmg"
/usr/bin/hdiutil create \
    -volname "Librairii ${version}" \
    -srcfolder "$staging_root" \
    -ov \
    -format UDZO \
    "$artifact"
artifact_directory="$(dirname -- "$artifact")"
artifact_name="$(basename -- "$artifact")"
(
    cd "$artifact_directory"
    /usr/bin/shasum -a 256 "$artifact_name" > "$artifact_name.sha256"
)

printf 'current installer: %s\n' "$artifact"
printf 'current installer checksum: %s.sha256\n' "$artifact"
