#!/usr/bin/env bash
# Use Ubuntu's signed archives for Ubuntu packages. Runner-added vendor feeds
# (notably Microsoft's 24.04 feed) are unrelated and can fail independently.
set -euo pipefail
. /etc/os-release
if [[ "$ID" != ubuntu || "$VERSION_ID" != 24.04 ]]; then
  echo 'ubuntu-apt requires Ubuntu 24.04' >&2
  exit 1
fi
if [[ $# -eq 0 ]]; then
  echo 'Specify packages to install' >&2
  exit 1
fi
sources="$(mktemp -d "${RUNNER_TEMP:?}/librairii-apt.XXXXXX")"
trap 'rm -rf -- "$sources"' EXIT
cat > "$sources/ubuntu.sources" <<'SOURCES'
Types: deb
URIs: http://archive.ubuntu.com/ubuntu
Suites: noble noble-updates noble-backports
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: http://security.ubuntu.com/ubuntu
Suites: noble-security
Components: main restricted universe multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES
options=(-o Dir::Etc::sourcelist=/dev/null -o "Dir::Etc::sourceparts=$sources" -o APT::Get::List-Cleanup=0)
sudo apt-get "${options[@]}" update
sudo apt-get "${options[@]}" install -y "$@"
