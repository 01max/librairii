import { Button, LineEdit, VerticalBox, HorizontalBox, ListView, StandardListView, ProgressIndicator, CheckBox, AboutSlint, Palette, ScrollView } from "std-widgets.slint";

export struct StoryRow { id: int, title: string, cover: image }
export struct DecisionRow { id: int, added: bool }
export enum EditAction { undo, redo, cut, copy, paste, select-all }

global ProbeState {
    in-out property <bool> modal: false;
    in-out property <int> focus-key: 30;
    in-out property <int> restore-epoch: 0;
}
component Action inherits Button {
    in property <int> focus-key: 0;
    private property <int> restore-epoch: ProbeState.restore-epoch;
    enabled: !ProbeState.modal;
    changed has-focus => { if self.has-focus && !ProbeState.modal { ProbeState.focus-key = self.focus-key; } }
    changed restore-epoch => { if !ProbeState.modal && ProbeState.focus-key == self.focus-key { self.focus(); } }
}
component DecisionCheck inherits CheckBox {
    in property <int> focus-key;
    private property <int> restore-epoch: ProbeState.restore-epoch;
    changed has-focus => { if self.has-focus && !ProbeState.modal { ProbeState.focus-key = self.focus-key; } }
    changed restore-epoch => { if !ProbeState.modal && ProbeState.focus-key == self.focus-key { self.focus(); } }
}
component SearchField inherits LineEdit {
    private property <int> restore-epoch: ProbeState.restore-epoch;
    changed has-focus => { if self.has-focus && !ProbeState.modal { ProbeState.focus-key = 30; } }
    changed restore-epoch => { if !ProbeState.modal && ProbeState.focus-key == 30 { self.focus(); } }
}
// Uniform-height virtualization keeps the delegated accessibility focus relative
// to the mounted rows. StandardListView1.18.1 delegates the absolute model index,
// which falls outside its accessible descendants after an offscreen seek.
component StoryList inherits FocusScope {
    in property <[StandardListViewItem]> model;
    in-out property <int> current-item: 0;
    callback current-item-changed(int);
    private property <int> focused-row: 0;
    private property <length> row-height: 36px;
    accessible-role: list;
    accessible-label: "Stories";
    accessible-enabled: self.enabled;
    accessible-item-count: root.model.length;
    accessible-delegate-focus: root.focused-row - floor(-view.content-y / root.row-height);
    private property <int> restore-epoch: ProbeState.restore-epoch;
    changed restore-epoch => { if !ProbeState.modal && ProbeState.focus-key == 31 { root.focus(); } }
    function move(index: int, select: bool) {
        root.focused-row = max(0, min(root.model.length - 1, index));
        if root.focused-row * root.row-height + view.content-y < 0px {
            view.content-y = -root.focused-row * root.row-height;
        } else if (root.focused-row + 1) * root.row-height + view.content-y > view.visible-height {
            view.content-y = view.visible-height - (root.focused-row + 1) * root.row-height;
        }
        if select {
            root.current-item = root.focused-row;
            root.current-item-changed(root.current-item);
        }
    }
        focus-changed-event => {
            if self.has-focus {
                ProbeState.focus-key = 31;
                root.move(root.current-item, false);
            }
        }
        key-pressed(event) => {
            if event.text == Key.End { root.move(root.model.length - 1, !event.modifiers.control); }
            else if event.text == Key.Home { root.move(0, !event.modifiers.control); }
            else if event.text == Key.DownArrow { root.move(root.focused-row + 1, !event.modifiers.control); }
            else if event.text == Key.UpArrow { root.move(root.focused-row - 1, !event.modifiers.control); }
            else if event.text == Key.PageDown { root.move(root.focused-row + max(1, floor(view.visible-height / root.row-height)), !event.modifiers.control); }
            else if event.text == Key.PageUp { root.move(root.focused-row - max(1, floor(view.visible-height / root.row-height)), !event.modifiers.control); }
            else if event.text == Key.Space { root.move(root.focused-row, true); }
            else { return reject; }
            return accept;
        }
    view := ListView {
        width: parent.width; height: parent.height;
        accessible-role: none;
    for item[index] in root.model: Rectangle {
        height: root.row-height;
        background: index == root.current-item ? Palette.selection-background : Palette.background;
        accessible-role: list-item;
        accessible-label: item.text;
        accessible-enabled: root.enabled;
        accessible-item-selectable: true;
        accessible-item-selected: index == root.current-item;
        accessible-action-default => { root.move(index, true); root.focus(); }
        Text {
            x: 8px; width: parent.width - 16px; vertical-alignment: center; height: parent.height;
            text: item.text; overflow: elide;
            color: index == root.current-item ? Palette.selection-foreground : Palette.foreground;
        }
        if root.has-focus && index == root.focused-row: Rectangle {
            border-width: 2px; border-color: Palette.foreground; background: transparent;
        }
        TouchArea { enabled: root.enabled; clicked => { root.move(index, true); root.focus(); } }
    }
    }
}

export component Spike inherits Window {
    title: "Librairii · qualification";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 560px;
    min-height: 400px;
    background: Palette.background;
    in-out property <bool> french: false;
    in-out property <int> mode: 0;
    in-out property <bool> review-visible: false;
    in-out property <bool> sidebar-open: false;
    in-out property <int> dialog: 0;
    in-out property <bool> native-dialog-open: false;
    private property <int> invoker: 0;
    in-out property <bool> compact: false;
    in-out property <bool> wide: true;
    out property <int> observed-focus-key: ProbeState.focus-key;
    out property <bool> modal: root.dialog != 0;
    in-out property <string> query;
    in-out property <string> selected: "Étoiles — 日本語 — 故事";
    in-out property <int> selected-id: 0;
    in-out property <int> selected-row-index: 0;
    in property <[StandardListViewItem]> story-list;
    in property <[StoryRow]> stories;
    in property <[[StoryRow]]> grid;
    in-out property <[DecisionRow]> decisions;
    in property <int> review-page: 0;
    in property <int> review-pages: 12;
    in property <float> progress: 0;
    in property <string> status;
    in property <bool> working: false;
    in property <int> approvals: 0;
    in-out property <bool> first-added: false;
    out property <bool> first-decision-has-focus: first-decision.has-focus;
    out property <bool> first-decision-checked: first-decision.checked;
    out property <bool> close-has-focus: close-button.has-focus;
    out property <bool> settings-has-focus: settings-button.has-focus;
    out property <bool> search-has-focus: search-entry.has-focus;
    callback search(string);
    callback select-story(int);
    callback start-work();
    callback cancel-work();
    callback simulate-error();
    callback request-quit();
    callback decide(int, bool);
    callback apply-review();
    callback change-review-page(int);
    callback pick-files();
    callback pick-folder();
    callback reveal-fixture();
    callback focus-first-decision();
    focus-first-decision => { first-decision.focus(); }
    callback focus-apply();
    focus-apply => { apply-button.focus(); }
    callback focus-search();
    focus-search => { search-entry.focus(); }
    callback edit-observed(EditAction, bool);
    // AppKit's predefined edit selectors do not reach the Winit text input.
    // Keep editing inside the focused widget, including its selection/undo state.
    public function edit-search(action: EditAction) {
        let allowed = !root.modal && !root.native-dialog-open && search-entry.has-focus;
        root.edit-observed(action, allowed);
        if allowed {
            if action == EditAction.undo { search-entry.undo(); }
            else if action == EditAction.redo { search-entry.redo(); }
            else if action == EditAction.cut { search-entry.cut(); }
            else if action == EditAction.copy { search-entry.copy(); }
            else if action == EditAction.paste { search-entry.paste(); }
            else if action == EditAction.select-all { search-entry.select-all(); }
        }
    }

    public function open-dialog(kind: int, from: int) {
        if root.dialog == 0 {
            root.invoker = from;
            root.dialog = kind;
            ProbeState.modal = true;
            close-button.focus();
        }
    }
    public function close-dialog() {
        root.dialog = 0;
        ProbeState.modal = false;
        if root.invoker == 1 { details-button.focus(); }
        else if root.invoker == 2 { ProbeState.restore-epoch += 1; }
        else { settings-button.focus(); }
    }
    public function open-sidebar() {
        root.sidebar-open = true;
        library-button.focus();
    }
    public function close-sidebar() {
        root.sidebar-open = false;
        navigation-button.focus();
    }
    in-out property <bool> macos-menus: false;
    MenuBar {
        if !root.macos-menus: Menu {
            title: "Librairii";
            MenuItem { enabled: !root.modal; title: root.french ? "Réglages…" : "Settings…"; shortcut: @keys(Control + ","); activated => { root.open-dialog(1, 2); } }
            MenuItem { enabled: !root.modal; title: root.french ? "À propos…" : "About…"; activated => { root.open-dialog(2, 2); } }
            MenuItem { title: root.french ? "Quitter" : "Quit"; shortcut: @keys(Control + Q); activated => { root.request-quit(); } }
        }
    }
    key-scope := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if root.modal {
                if event.text == Key.Escape { root.close-dialog(); return accept; }
                if event.text == Key.Tab || event.text == Key.Backtab {
                    if root.dialog == 1 {
                        if close-button.has-focus {
                            if event.modifiers.shift { french-button.focus(); } else { english-button.focus(); }
                        } else if english-button.has-focus {
                            if event.modifiers.shift { close-button.focus(); } else { french-button.focus(); }
                        } else {
                            if event.modifiers.shift { english-button.focus(); } else { close-button.focus(); }
                        }
                    } else { close-button.focus(); }
                    return accept;
                }
            }
            if root.compact && root.sidebar-open && event.text == Key.Escape { root.close-sidebar(); return accept; }
            return reject;
        }
        VerticalBox {
            min-width: 0px; min-height: 0px; padding: 12px;
            HorizontalBox {
                min-width: 0px;
                navigation-button := Action { focus-key: 1;
                    visible: root.compact;
                    text: root.french ? "Navigation" : "Navigation";
                    clicked => { root.open-sidebar(); }
                }
                Text { text: "librairii"; font-size: 22px; font-weight: 700; }
                search-entry := SearchField {
                    min-width: 0px;
                    enabled: !root.modal;
                    text <=> root.query;
                    placeholder-text: root.french ? "Rechercher des histoires" : "Search stories";
                    accessible-label: self.placeholder-text;
                    edited => { root.search(self.text); }
                }
                settings-button := Action { focus-key: 2; text: root.french ? "Réglages" : "Settings"; clicked => { root.open-dialog(1, 0); } }
            }
            HorizontalBox {
                min-width: 0px; min-height: 0px;
                sidebar := Rectangle {
                    visible: !root.compact || root.sidebar-open;
                    width: self.visible ? 170px : 0px;
                    background: Palette.alternate-background;
                    accessible-role: navigation;
                    accessible-label: root.french ? "Navigation de la bibliothèque" : "Library navigation";
                    VerticalBox {
                        min-width: 0px; min-height: 0px;
                        Text { text: root.french ? "BIBLIOTHÈQUE" : "LIBRARY"; }
                        library-button := Action { focus-key: 3; text: root.french ? "Toutes les histoires" : "All stories"; clicked => { root.review-visible = false; if root.compact { root.close-sidebar(); } } }
                        Text { text: "Collections"; font-weight: 700; }
                        Action { focus-key: 4; text: root.french ? "Les favoris" : "Favourites"; clicked => { root.review-visible = false; if root.compact { root.close-sidebar(); } } }
                        Text { text: root.french ? "Étagères" : "Shelves"; font-weight: 700; }
                        Action { focus-key: 5; text: root.french ? "Membres approuvés" : "Approved members"; clicked => { root.review-visible = true; if root.compact { root.close-sidebar(); } } }
                        Action { focus-key: 6; visible: root.compact; text: root.french ? "Fermer la navigation" : "Close navigation"; clicked => { root.close-sidebar(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                VerticalBox {
                    min-width: 0px; min-height: 0px;
                    HorizontalBox {
                        Action { focus-key: 7; text: root.french ? "Liste" : "List"; clicked => { root.mode = 0; } }
                        Action { focus-key: 8; text: root.french ? "Petites couvertures" : "Small covers"; clicked => { root.mode = 1; } }
                        Action { focus-key: 9; text: root.french ? "Grandes couvertures" : "Large covers"; clicked => { root.mode = 2; } }
                    }
                    HorizontalBox {
                        Text { text: root.stories.length + (root.french ? " histoires synthétiques" : " synthetic stories"); }
                        Action { focus-key: 10; text: root.french ? "Révision" : "Review"; clicked => { root.review-visible = !root.review-visible; } }
                        details-button := Action { focus-key: 11; text: root.french ? "Détails" : "Details"; clicked => { root.open-dialog(3, 1); } }
                    }
                    if root.mode == 0: StoryList {
                        min-width: 0px; min-height: 0px;
                        enabled: !root.modal;
                        accessible-label: root.french ? "Histoires" : "Stories";
                        model: root.story-list;
                        current-item <=> root.selected-row-index;
                        current-item-changed(index) => {
                            if index >= 0 && index < root.stories.length { root.select-story(root.stories[index].id); }
                        }
                    }
                    if root.mode != 0: ListView {
                        min-width: 0px; min-height: 0px;
                        for row in root.grid: HorizontalBox {
                            min-width: 0px;
                            for story in row: VerticalBox {
                                min-width: 0px;
                                Image { source: story.cover; height: root.mode == 1 ? 75px : 130px; image-fit: contain; }
                                Action {
                                    focus-key: 1000 + story.id; min-width: 0px; text: story.title;
                                    checked: story.id == root.selected-id;
                                    accessible-role: list-item;
                                    accessible-item-selectable: true;
                                    accessible-item-selected: story.id == root.selected-id;
                                    clicked => { root.select-story(story.id); }
                                }
                            }
                        }
                    }
                    review-pane := VerticalBox {
                        visible: root.review-visible;
                        height: root.review-visible ? 220px : 0px;
                        min-width: 0px;
                        Text { text: root.french ? "Révision séparée — aucune approbation implicite" : "Separate review — no implicit approvals"; wrap: word-wrap; }
                        HorizontalBox {
                            Action { focus-key: 12; text: root.french ? "Précédent" : "Previous"; enabled: !root.modal && root.review-page > 0; clicked => { root.change-review-page(root.review-page - 1); } }
                            Text { text: (root.review-page + 1) + " / " + root.review-pages + " · 300"; }
                            Action { focus-key: 13; text: root.french ? "Suivant" : "Next"; enabled: !root.modal && root.review-page + 1 < root.review-pages; clicked => { root.change-review-page(root.review-page + 1); } }
                            apply-button := Action { focus-key: 14; text: (root.french ? "Appliquer " : "Apply ") + root.approvals; enabled: !root.modal && root.approvals > 0; clicked => { root.apply-review(); } }
                        }
                        ScrollView {
                            min-height: 0px; min-width: 0px;
                            VerticalBox {
                                first-decision := DecisionCheck {
                                    focus-key: 2000 + root.review-page * 25;
                                    enabled: !root.modal;
                                    text: (root.french ? "Ajouter " : "Add ") + (root.review-page * 25) + (root.french ? " · Sinon : pas maintenant" : " · Otherwise: Not now");
                                    checked <=> root.first-added;
                                    toggled => { root.decide(0, self.checked); }
                                }
                                for row[index] in root.decisions: DecisionCheck {
                                    focus-key: 2000 + row.id;
                                    enabled: !root.modal;
                                    text: (root.french ? "Ajouter " : "Add ") + row.id + (root.french ? " · Sinon : pas maintenant" : " · Otherwise: Not now");
                                    checked <=> row.added;
                                    toggled => { root.decide(index + 1, self.checked); }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    visible: root.wide;
                    width: self.visible ? 230px : 0px;
                    background: Palette.alternate-background;
                    accessible-role: complementary;
                    accessible-label: root.french ? "Histoire sélectionnée" : "Story inspector";
                    VerticalBox {
                        min-width: 0px;
                        Text { text: root.french ? "HISTOIRE SÉLECTIONNÉE" : "STORY INSPECTOR"; wrap: word-wrap; }
                        Text { text: root.selected; wrap: word-wrap; }
                        Text { text: root.french ? "Français · 4–6 ans" : "French · Ages 4–6"; }
                        Text { text: root.french ? "Avertissement : indisponible" : "Warning: unavailable"; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            HorizontalBox {
                Action { focus-key: 15; text: root.french ? "Choisir des fichiers" : "Choose files"; clicked => { root.pick-files(); } }
                Action { focus-key: 16; text: root.french ? "Choisir un dossier" : "Choose folder"; clicked => { root.pick-folder(); } }
                Action { focus-key: 17; text: root.french ? "Afficher le dossier" : "Reveal fixture"; clicked => { root.reveal-fixture(); } }
            }
            HorizontalBox {
                Action { focus-key: 18; text: root.french ? "Travail synthétique" : "Synthetic work"; enabled: !root.modal && !root.working; clicked => { root.start-work(); } }
                Action { focus-key: 19; text: root.french ? "Annuler" : "Cancel"; enabled: !root.modal && root.working; clicked => { root.cancel-work(); } }
                Action { focus-key: 20; text: root.french ? "Erreur synthétique" : "Synthetic error"; clicked => { root.simulate-error(); } }
                ProgressIndicator { progress: root.progress; }
            }
            Text { text: root.status; wrap: word-wrap; accessible-live-region: polite; }
        }
        if root.modal: TouchArea { clicked => { /* The backdrop deliberately does not accept decisions. */ } }
        dialog-panel := Rectangle {
            visible: root.modal;
            x: 24px; y: 32px; width: parent.width - 48px; height: parent.height - 64px;
            background: Palette.background;
            border-width: 2px; border-color: Palette.foreground;
            accessible-role: groupbox;
            accessible-label: root.dialog == 1 ? (root.french ? "Réglages" : "Settings") : root.dialog == 2 ? (root.french ? "À propos" : "About") : (root.french ? "Détails" : "Details");
            VerticalBox {
                min-width: 0px; min-height: 0px; padding: 18px;
                Text { text: dialog-panel.accessible-label; font-size: 24px; }
                if root.dialog == 2: AboutSlint { }
                if root.dialog == 3: Text { text: root.selected; wrap: word-wrap; }
                HorizontalBox {
                    visible: root.dialog == 1;
                    english-button := Button { text: "English"; clicked => { root.french = false; } }
                    french-button := Button { text: "Français"; clicked => { root.french = true; } }
                }
                Rectangle { vertical-stretch: 1; }
                close-button := Button { text: root.french ? "Fermer" : "Close"; clicked => { root.close-dialog(); } }
            }
        }
    }
}
